+
+        private static string describe(LinkedScoreOwner owner)
+        {
+            if (LocalPriorityPolicy.IsOfflineProfileUser(new Online.API.Requests.Responses.APIUser { Id = owner.UserId }))
+                return @"an earlier local profile";
