+            }
+            catch (Exception e)
+            {
+                Logger.Error(e, @"Ritsu: could not look for plays with the same name.");
+                return;
+            }
+
+            if (found.count == 0)
+            {
+                if (tellWhenNoneFound)
+                    dialogs.Push(new NothingFoundDialog(profile.Name));
