+            private static Drawable bigValue(string title, string content, string? tooltip = null)
+            {
+                var display = new ProfileValueDisplay(true)
+                {
+                    Title = title,
+                };
+                display.Content.Text = content;
+                display.Content.TooltipText = tooltip ?? string.Empty;
+                return display;
+            }
