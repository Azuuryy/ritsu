+++ b/osu.Game/LocalPriority/ILocalProfileApi.cs
@@ -0,0 +1,33 @@
+// Copyright (c) 2026 Ritsu contributors. Licensed under the MIT Licence.
+using System;
+using osu.Game.Online.API.Requests.Responses;
+
+namespace osu.Game.LocalPriority
+{
+    /// <summary>
+    /// The part of the API provider that local profiles drive: which local profile is shown as the player.
+    /// In Ritsu this is implemented by <see cref="Offline.OfflineAPIProvider"/>, which never goes online.
+    /// </summary>
+    public interface ILocalProfileApi
+    {
+        /// <summary>
+        /// The active local profile's user, or null when no local profile is active.
+        /// </summary>
+        APIUser? ActiveOfflineUser { get; }
+
+        /// <summary>
+        /// Invoked when the player asked for the online account, so the profile list can follow.
+        /// </summary>
+        event Action? OnlineAccountRequested;
+
+        /// <summary>
+        /// Show a local profile as the player (scores are saved under it), or none by passing null.
+        /// </summary>
+        void SetOfflineProfile(APIUser? localUser);
+
+        /// <summary>
+        /// Whether local profiles may use a signed-in online account for read-only lookups.
+        /// </summary>
+        void SetLocalProfilesUseOnlineAccount(bool value);
+    }
+}
diff --git a/osu.Game/LocalPriority/LocalAutoSwitchPopover.cs b/osu.Game/LocalPriority/LocalAutoSwitchPopover.cs
new file mode 100644
index 0000000000..26565c162e
--- /dev/null
+++ b/osu.Game/LocalPriority/LocalAutoSwitchPopover.cs
@@ -0,0 +1,271 @@
+// Copyright (c) 2026 Ritsu contributors. Licensed under the MIT Licence.
+using System;
+using System.Linq;
+using osu.Framework.Allocation;
+using osu.Framework.Extensions;
+using osu.Framework.Graphics;
+using osu.Framework.Graphics.Containers;
+using osu.Game.Graphics;
+using osu.Game.Graphics.Containers;
+using osu.Game.Graphics.Sprites;
+using osu.Game.Graphics.UserInterface;
+using osu.Game.Graphics.UserInterfaceV2;
+using osu.Game.Overlays;
+using osuTK;
+
+namespace osu.Game.LocalPriority
+{
+    /// <summary>
+    /// "Auto-switch rules" of a profile (right-click its chip on the profile page): which beatmaps make it active by itself.
+    /// </summary>
+    public partial class LocalAutoSwitchPopover : OsuPopover
+    {
+        private readonly LocalProfile profile;
+        private readonly LocalProfileManager manager;
+
+        private OsuCheckbox enabled = null!;
+        private OsuTextBox tags = null!;
+        private OsuTextBox stars = null!;
+        private OsuTextBox bpm = null!;
+        private OsuTextBox length = null!;
+        private OsuTextBox mapper = null!;
+        private OsuTextBox name = null!;
+        private OsuSpriteText error = null!;
+        private RoundedButton modsButton = null!;
+
+        /// <summary>
+        /// The mods condition as last picked (kept until "Save").
+        /// </summary>
+        private LocalAutoSwitchRules modsCondition = null!;
+
+        [Resolved]
+        private IOverlayManager? overlays { get; set; }
+
+        [Resolved]
+        private LocalProfileOverlay? profileOverlay { get; set; }
+
+        public LocalAutoSwitchPopover(LocalProfile profile, LocalProfileManager manager)
+        {
+            this.profile = profile;
+            this.manager = manager;
+        }
+
+        [BackgroundDependencyLoader]
+        private void load(OsuColour colours)
+        {
+            var rules = profile.AutoSwitch ?? new LocalAutoSwitchRules();
+            modsCondition = rules.Clone();
+
+            Child = new FillFlowContainer
+            {
+                Width = 360,
+                AutoSizeAxes = Axes.Y,
+                Direction = FillDirection.Vertical,
+                Spacing = new Vector2(0, 8),
+                Children = new Drawable[]
+                {
+                    new OsuSpriteText
+                    {
+                        Text = $@"Auto-switch to ""{profile.Name}""",
+                        Font = OsuFont.GetFont(size: 18, weight: FontWeight.Bold),
+                    },
+                    new OsuTextFlowContainer(t => t.Font = OsuFont.GetFont(size: 12))
+                    {
+                        RelativeSizeAxes = Axes.X,
+                        AutoSizeAxes = Axes.Y,
+                        Alpha = 0.75f,
+                        Text = @"Selecting a beatmap (and mods) in song select that matches every filled-in condition makes this profile active. "
+                               + @"On beatmaps no profile wants, the profile from before comes back. Ranges: ""5-7"", ""5+"", ""-7"" or ""6"".",
+                    },
+                    enabled = new OsuCheckbox
+                    {
+                        RelativeSizeAxes = Axes.X,
+                        LabelText = @"Switch to this profile automatically",
+                        Current = { Value = profile.AutoSwitch?.Enabled ?? true },
+                    },
+                    field(@"Tags (any of them; local, voted or mapper tags)", tags = box(string.Join(@", ", rules.Tags), @"skillset/jumps, jumps/cross-screen")),
+                    field(@"Star rating", stars = box(LocalAutoSwitchRules.FormatRange(rules.MinStars, rules.MaxStars), @"e.g. 5-7")),
+                    field(@"BPM", bpm = box(LocalAutoSwitchRules.FormatRange(rules.MinBpm, rules.MaxBpm), @"e.g. 180+")),
+                    field(@"Length in seconds", length = box(LocalAutoSwitchRules.FormatRange(rules.MinLength, rules.MaxLength), @"e.g. 60-240")),
+                    field(@"Mapper (part of the name)", mapper = box(rules.Mapper, string.Empty)),
+                    field(@"Title, artist or difficulty (part of it)", name = box(rules.Name, string.Empty)),
+                    field(@"Selected mods", modsButton = new RoundedButton
+                    {
+                        RelativeSizeAxes = Axes.X,
+                        Action = pickMods,
+                    }),
+                    error = new OsuSpriteText
+                    {
+                        Font = OsuFont.GetFont(size: 12, weight: FontWeight.SemiBold),
+                        Colour = colours.Red1,
+                        Alpha = 0,
+                    },
+                    new FillFlowContainer
+                    {
+                        RelativeSizeAxes = Axes.X,
+                        AutoSizeAxes = Axes.Y,
+                        Direction = FillDirection.Horizontal,
+                        Spacing = new Vector2(8, 0),
+                        Children = new Drawable[]
+                        {
+                            new RoundedButton
+                            {
+                                Width = 170,
+                                Text = @"Save",
+                                Action = save,
+                            },
+                            new RoundedButton
+                            {
+                                Width = 170,
+                                Text = @"Remove rules",
+                                BackgroundColour = colours.Red3,
+                                Action = () =>
+                                {
+                                    manager.SetAutoSwitch(profile.Id, null);
+                                    this.HidePopover();
+                                },
+                            },
+                        },
+                    },
+                },
+            };
+        }
+
+        protected override void LoadComplete()
+        {
+            base.LoadComplete();
+            updateModsButton();
+        }
+
+        private void updateModsButton() => modsButton.Text = modsCondition.Mods.Count == 0 ? @"Any mods (click to pick mods)" : modsCondition.DescribeMods();
+
+        /// <summary>
+        /// Opens the mod rules picker for this rule's mods. The profile page makes room for it, so what is filled in here is saved first
+        /// (when it is valid), and the page comes back with this editor open afterwards.
+        /// </summary>
+        private void pickMods()
+        {
+            if (overlays == null)
+                return;
+
+            var current = tryBuildRules(out string? problem);
+
+            if (current == null)
+            {
+                showError(problem!);
+                return;
+            }
+
+            if (current.HasAnyCondition)
+                manager.SetAutoSwitch(profile.Id, current);
+
+            Guid id = profile.Id;
+
+            LocalProfileModRulesOverlay.PickAutoSwitchMods(overlays, current, $@"auto-switch mods for {profile.Name}",
+                picked => manager.SetAutoSwitch(id, picked.HasAnyCondition ? picked : null),
+                () => profileOverlay?.ShowAutoSwitchRules(id),
+                () =>
+                {
+                    this.HidePopover();
+                    profileOverlay?.Hide();
+                });
+        }
+
+        private static OsuTextBox box(string text, string placeholder) => new OsuTextBox
+        {
+            RelativeSizeAxes = Axes.X,
+            Text = text,
+            PlaceholderText = placeholder,
+            CommitOnFocusLost = true,
+        };
+
+        private static Drawable field(string label, Drawable control) => new FillFlowContainer
+        {
+            RelativeSizeAxes = Axes.X,
+            AutoSizeAxes = Axes.Y,
+            Direction = FillDirection.Vertical,
+            Spacing = new Vector2(0, 2),
+            Children = new[]
+            {
+                new OsuSpriteText
+                {
+                    Text = label,
+                    Font = OsuFont.GetFont(size: 12, weight: FontWeight.SemiBold),
+                },
+                control,
+            },
+        };
+
+        /// <summary>
+        /// The rule as filled in, or null (with the reason) when a range can't be read.
+        /// </summary>
+        private LocalAutoSwitchRules? tryBuildRules(out string? problem)
+        {
+            problem = null;
+
+            var rules = new LocalAutoSwitchRules
+            {
+                Enabled = enabled.Current.Value,
+                Tags = tags.Text.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(LocalBeatmapTags.Normalise).Where(t => t.Length > 0).Distinct().ToList(),
+                Mapper = mapper.Text.Trim(),
+                Name = name.Text.Trim(),
+                Mods = modsCondition.Clone().Mods,
+                ModMatch = modsCondition.ModMatch,
+                ExactModSettings = modsCondition.ExactModSettings,
+            };
+
+            if (!LocalAutoSwitchRules.TryParseRange(stars.Text, out double? minStars, out double? maxStars))
+            {
+                problem = @"Star rating: use a range like 5-7, 5+, -7 or 6.";
+                return null;
+            }
+
+            if (!LocalAutoSwitchRules.TryParseRange(bpm.Text, out double? minBpm, out double? maxBpm))
+            {
+                problem = @"BPM: use a range like 180-220, 180+, -220 or 200.";
+                return null;
+            }
+
+            if (!LocalAutoSwitchRules.TryParseRange(length.Text, out double? minLength, out double? maxLength))
+            {
+                problem = @"Length: use seconds, like 60-240, 60+, -240 or 120.";
+                return null;
+            }
+
+            rules.MinStars = minStars;
+            rules.MaxStars = maxStars;
+            rules.MinBpm = minBpm;
+            rules.MaxBpm = maxBpm;
+            rules.MinLength = minLength;
+            rules.MaxLength = maxLength;
+
+            return rules;
+        }
+
+        private void save()
+        {
+            var rules = tryBuildRules(out string? problem);
+
+            if (rules == null)
+            {
+                showError(problem!);
+                return;
+            }
+
+            if (!rules.HasAnyCondition)
+            {
+                showError(@"Fill in at least one condition (or use ""Remove rules"").");
+                return;
+            }
+
+            manager.SetAutoSwitch(profile.Id, rules);
+            this.HidePopover();
+        }
+
+        private void showError(string text)
+        {
+            error.Text = text;
+            error.FadeIn(100);
+        }
+    }
+}
diff --git a/osu.Game/LocalPriority/LocalAutoSwitchRules.cs b/osu.Game/LocalPriority/LocalAutoSwitchRules.cs
new file mode 100644
index 0000000000..1dc2387288
--- /dev/null
+++ b/osu.Game/LocalPriority/LocalAutoSwitchRules.cs
@@ -0,0 +1,272 @@
+// Copyright (c) 2026 Ritsu contributors. Licensed under the MIT Licence.
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+using osu.Game.Beatmaps;
+using osu.Game.Online.API;
+using osu.Game.Rulesets;
+using osu.Game.Rulesets.Mods;
+using osu.Game.Scoring;
+
+namespace osu.Game.LocalPriority
+{
+    /// <summary>
+    /// How the selected mods have to line up with an auto-switch rule's mods.
+    /// </summary>
+    public enum LocalAutoSwitchModMatch
+    {
+        /// <summary>
+        /// Every one of the rule's mods is selected (other mods may be selected too).
+        /// </summary>
+        All,
+
+        /// <summary>
+        /// At least one of the rule's mods is selected.
+        /// </summary>
+        Any,
+
+        /// <summary>
+        /// Exactly the rule's mods are selected, nothing more and nothing less.
+        /// </summary>
+        Exact,
+    }
+
+    /// <summary>
+    /// When a profile becomes active by itself: selecting a beatmap in song select that matches every condition that is filled in.
+    /// </summary>
+    public class LocalAutoSwitchRules
+    {
+        public bool Enabled { get; set; } = true;
+
+        /// <summary>
+        /// The beatmap needs at least one of these tags (local tags, voted tags or the mapper's tags), e.g. "skillset/jumps".
+        /// </summary>
+        public List<string> Tags { get; set; } = new List<string>();
+
+        public double? MinStars { get; set; }
+        public double? MaxStars { get; set; }
+
+        public double? MinBpm { get; set; }
+        public double? MaxBpm { get; set; }
+
+        /// <summary>
+        /// Length in seconds.
+        /// </summary>
+        public double? MinLength { get; set; }
+
+        public double? MaxLength { get; set; }
+
+        /// <summary>
+        /// Part of the mapper's name.
+        /// </summary>
+        public string Mapper { get; set; } = string.Empty;
+
+        /// <summary>
+        /// Part of the title, artist or difficulty name.
+        /// </summary>
+        public string Name { get; set; } = string.Empty;
+
+        /// <summary>
+        /// Mods that have to be selected (picked in the mod rules picker; how they have to match: <see cref="ModMatch"/>).
+        /// </summary>
+        public List<APIMod> Mods { get; set; } = new List<APIMod>();
+
+        public LocalAutoSwitchModMatch ModMatch { get; set; } = LocalAutoSwitchModMatch.All;
+
+        /// <summary>
+        /// The mods only count when their settings are exactly the picked ones (e.g. Double Time at 1.3x only).
+        /// </summary>
+        public bool ExactModSettings { get; set; }
+
+        public bool HasAnyCondition =>
+            Tags.Count > 0 || MinStars != null || MaxStars != null || MinBpm != null || MaxBpm != null || MinLength != null || MaxLength != null
+            || !string.IsNullOrWhiteSpace(Mapper) || !string.IsNullOrWhiteSpace(Name) || Mods.Count > 0;
+
+        /// <param name="beatmap">The selected beatmap.</param>
+        /// <param name="selectedMods">The selected mods (only needed for rules with mods).</param>
+        /// <param name="ruleset">The current ruleset, to read the rule's mods with (only needed for rules with mods).</param>
+        public bool Matches(BeatmapInfo beatmap, IReadOnlyList<Mod> selectedMods, Ruleset? ruleset)
+        {
+            if (!Enabled || !HasAnyCondition)
+                return false;
+
+            if (Mods.Count > 0 && !modsMatch(selectedMods, ruleset))
+                return false;
+
+            if (Tags.Count > 0)
+            {
+                var beatmapTags = (LocalBeatmapTags.Current?.Get(beatmap) ?? Array.Empty<string>())
+                                  .Concat(beatmap.Metadata.UserTags)
+                                  .Concat(beatmap.Metadata.Tags.Split(' ', StringSplitOptions.RemoveEmptyEntries))
+                                  .Select(LocalBeatmapTags.Normalise)
+                                  .ToHashSet();
+
+                if (!Tags.Any(t => beatmapTags.Contains(LocalBeatmapTags.Normalise(t))))
+                    return false;
+            }
+
+            if (!inRange(beatmap.StarRating, MinStars, MaxStars))
+                return false;
+
+            if (!inRange(beatmap.BPM, MinBpm, MaxBpm))
+                return false;
+
+            if (!inRange(beatmap.Length / 1000, MinLength, MaxLength))
+                return false;
+
+            if (!string.IsNullOrWhiteSpace(Mapper) && !contains(beatmap.Metadata.Author.Username, Mapper))
+                return false;
+
+            if (!string.IsNullOrWhiteSpace(Name)
+                && !contains(beatmap.Metadata.Title, Name) && !contains(beatmap.Metadata.TitleUnicode, Name)
+                && !contains(beatmap.Metadata.Artist, Name) && !contains(beatmap.Metadata.ArtistUnicode, Name)
+                && !contains(beatmap.DifficultyName, Name))
+                return false;
+
+            return true;
+        }
+
+        private bool modsMatch(IReadOnlyList<Mod> selectedMods, Ruleset? ruleset)
+        {
+            if (ruleset == null)
+                return false;
+
+            // Autoplay / Cinema (Ctrl+Enter) and system mods never decide anything.
+            var selected = selectedMods.Where(m => m is not ModAutoplay && m.Type != ModType.System).ToArray();
+
+            // Mods this ruleset doesn't have can never be selected.
+            var wanted = Mods.Select(m => m.ToMod(ruleset)).ToArray();
+
+            bool isSelected(Mod want)
+            {
+                if (want is UnknownMod)
+                    return false;
+
+                var found = selected.FirstOrDefault(s => s.GetType() == want.GetType());
+                return found != null && (!ExactModSettings || new APIMod(found).Equals(new APIMod(want)));
+            }
+
+            switch (ModMatch)
+            {
+                case LocalAutoSwitchModMatch.Any:
+                    return wanted.Any(isSelected);
+
+                case LocalAutoSwitchModMatch.Exact:
+                    return wanted.All(isSelected) && selected.Length == wanted.Select(w => w.GetType()).Distinct().Count();
+
+                default:
+                    return wanted.All(isSelected);
+            }
+        }
+
+        /// <summary>
+        /// "all of HD, HR", "any of HD, HR" or "exactly HD, HR", plus "(exact settings)".
+        /// </summary>
+        public string DescribeMods()
+        {
+            if (Mods.Count == 0)
+                return @"no mods";
+
+            string mods = string.Join(@", ", Mods.Select(m => m.Acronym));
+            string match = ModMatch switch
+            {
+                LocalAutoSwitchModMatch.Any => Mods.Count == 1 ? mods : $@"any of {mods}",
+                LocalAutoSwitchModMatch.Exact => $@"exactly {mods}",
+                _ => Mods.Count == 1 ? mods : $@"all of {mods}",
+            };
+
+            return ExactModSettings ? $@"{match} (exact settings)" : match;
+        }
+
+        private static bool inRange(double value, double? min, double? max) => (min == null || value >= min) && (max == null || value <= max);
+
+        private static bool contains(string? text, string part) => text?.Contains(part.Trim(), StringComparison.OrdinalIgnoreCase) == true;
+
+        /// <summary>
+        /// Short description, e.g. "tags skillset/jumps · 5–7★".
+        /// </summary>
+        public string Describe()
+        {
+            var parts = new List<string>();
+
+            if (Tags.Count > 0) parts.Add($@"tags {string.Join(@", ", Tags)}");
+            if (MinStars != null || MaxStars != null) parts.Add($@"{FormatRange(MinStars, MaxStars)}★");
+            if (MinBpm != null || MaxBpm != null) parts.Add($@"{FormatRange(MinBpm, MaxBpm)} BPM");
+            if (MinLength != null || MaxLength != null) parts.Add($@"{FormatRange(MinLength, MaxLength)}s");
+            if (!string.IsNullOrWhiteSpace(Mapper)) parts.Add($@"mapper ""{Mapper}""");
+            if (!string.IsNullOrWhiteSpace(Name)) parts.Add($@"name ""{Name}""");
+            if (Mods.Count > 0) parts.Add($@"mods {DescribeMods()}");
+
+            return parts.Count == 0 ? @"no conditions" : string.Join(@" · ", parts);
+        }
+
+        /// <summary>
+        /// "5-7", "5+", "-7", "6" (exactly) or "" for no limit.
+        /// </summary>
+        public static string FormatRange(double? min, double? max)
+        {
+            string f(double v) => v.ToString(@"0.##", CultureInfo.InvariantCulture);
+
+            if (min != null && max != null)
+                return min == max ? f(min.Value) : $@"{f(min.Value)}-{f(max.Value)}";
+            if (min != null)
+                return $@"{f(min.Value)}+";
+            if (max != null)
+                return $@"-{f(max.Value)}";
+
+            return string.Empty;
+        }
+
+        /// <summary>
+        /// Reads "5-7", "5+", "-7" or "6". Returns false for text that isn't a range.
+        /// </summary>
+        public static bool TryParseRange(string text, out double? min, out double? max)
+        {
+            min = max = null;
+            text = (text ?? string.Empty).Trim().Replace(',', '.').Replace('–', '-');
+
+            if (text.Length == 0)
+                return true;
+
+            static bool num(string s, out double v) => double.TryParse(s.Trim(), NumberStyles.Float, CultureInfo.InvariantCulture, out v);
+
+            if (text.EndsWith('+') && num(text[..^1], out double atLeast))
+            {
+                min = atLeast;
+                return true;
+            }
+
+            int dash = text.IndexOf('-', 1);
+
+            if (text.StartsWith('-') && num(text[1..], out double atMost))
+            {
+                max = atMost;
+                return true;
+            }
+
+            if (dash > 0 && num(text[..dash], out double from) && num(text[(dash + 1)..], out double to))
+            {
+                min = Math.Min(from, to);
+                max = Math.Max(from, to);
+                return true;
+            }
+
+            if (num(text, out double exact))
+            {
+                min = max = exact;
+                return true;
+            }
+
+            return false;
+        }
+
+        public LocalAutoSwitchRules Clone()
+        {
+            var clone = (LocalAutoSwitchRules)MemberwiseClone();
+            clone.Tags = new List<string>(Tags);
+            clone.Mods = Mods.Select(m => new APIMod { Acronym = m.Acronym, Settings = new Dictionary<string, object>(m.Settings) }).ToList();
+            return clone;
+        }
+    }
+}
diff --git a/osu.Game/LocalPriority/LocalBeatmapTags.cs b/osu.Game/LocalPriority/LocalBeatmapTags.cs
new file mode 100644
index 0000000000..a09c9a580f
--- /dev/null
+++ b/osu.Game/LocalPriority/LocalBeatmapTags.cs
@@ -0,0 +1,142 @@
+// Copyright (c) 2026 Ritsu contributors. Licensed under the MIT Licence.
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using Newtonsoft.Json;
+using osu.Framework.Logging;
+using osu.Framework.Platform;
+using osu.Game.Beatmaps;
+
+namespace osu.Game.LocalPriority
+{
+    /// <summary>
+    /// Tags you give beatmaps yourself (instead of the stripped online tag voting), per difficulty.
+    /// Kept in "osu-local/beatmap-tags.json", so the shared database is never changed.
+    /// They show in song select's beatmap details, can be searched like voted tags (tag="jumps/cross-screen"! or plain text),
+    /// and profiles can switch automatically on them.
+    /// </summary>
+    public class LocalBeatmapTags
+    {
+        private const string file = LocalProfileStore.DIRECTORY + @"/beatmap-tags.json";
+
+        /// <summary>
+        /// The tags of the running game (song select's filtering runs on background threads and reads them from here).
+        /// </summary>
+        public static LocalBeatmapTags? Current { get; internal set; }
+
+        /// <summary>
+        /// Invoked (on any thread) when tags change.
+        /// </summary>
+        public event Action? Changed;
+
+        private readonly Storage storage;
+        private readonly object sync = new object();
+        private readonly Dictionary<string, string[]> tags;
+
+        public LocalBeatmapTags(Storage storage)
+        {
+            this.storage = storage;
+            tags = read() ?? new Dictionary<string, string[]>();
+        }
+
+        /// <summary>
+        /// The local tags of a beatmap difficulty (keyed by its MD5 hash).
+        /// </summary>
+        public IReadOnlyList<string> Get(IBeatmapInfo? beatmap)
+        {
+            string? key = beatmap?.MD5Hash;
+
+            if (string.IsNullOrEmpty(key))
+                return Array.Empty<string>();
+
+            // Called for every beatmap while song select filters: no copying (the stored arrays are never changed, only replaced).
+            lock (sync)
+                return tags.Count > 0 && tags.TryGetValue(key, out string[]? list) ? list : Array.Empty<string>();
+        }
+
+        public static string Normalise(string tag) => string.Join(' ', (tag ?? string.Empty).Trim().ToLowerInvariant().Split(' ', StringSplitOptions.RemoveEmptyEntries));
+
+        public void Add(IBeatmapInfo beatmap, string tag)
+        {
+            tag = Normalise(tag);
+
+            if (string.IsNullOrEmpty(tag) || string.IsNullOrEmpty(beatmap.MD5Hash))
+                return;
+
+            lock (sync)
+            {
+                string[] list = tags.GetValueOrDefault(beatmap.MD5Hash) ?? Array.Empty<string>();
+
+                if (list.Contains(tag))
+                    return;
+
+                tags[beatmap.MD5Hash] = list.Append(tag).ToArray();
+                save();
+            }
+
+            Changed?.Invoke();
+        }
+
+        public void Remove(IBeatmapInfo beatmap, string tag)
+        {
+            lock (sync)
+            {
+                if (string.IsNullOrEmpty(beatmap.MD5Hash) || !tags.TryGetValue(beatmap.MD5Hash, out string[]? list) || !list.Contains(tag))
+                    return;
+
+                string[] remaining = list.Where(t => t != tag).ToArray();
+
+                if (remaining.Length == 0)
+                    tags.Remove(beatmap.MD5Hash);
+                else
+                    tags[beatmap.MD5Hash] = remaining;
+
+                save();
+            }
+
+            Changed?.Invoke();
+        }
+
+        /// <summary>
+        /// Every local tag used so far (for suggestions).
+        /// </summary>
+        public IReadOnlyList<string> AllTags()
+        {
+            lock (sync)
+                return tags.Values.SelectMany(t => t).Distinct().OrderBy(t => t).ToArray();
+        }
+
+        private Dictionary<string, string[]>? read()
+        {
+            try
+            {
+                if (!storage.Exists(file))
+                    return null;
+
+                using (var stream = storage.GetStream(file, FileAccess.Read, FileMode.Open))
+                using (var reader = new StreamReader(stream))
+                    return JsonConvert.DeserializeObject<Dictionary<string, string[]>>(reader.ReadToEnd());
+            }
+            catch (Exception e)
+            {
+                Logger.Error(e, $@"Ritsu: could not read {file}; starting without local beatmap tags.");
+                return null;
+            }
+        }
+
+        private void save()
+        {
+            try
+            {
+                using (var stream = storage.CreateFileSafely(file))
+                using (var writer = new StreamWriter(stream))
+                    writer.Write(JsonConvert.SerializeObject(tags, Formatting.Indented));
+            }
+            catch (Exception e)
+            {
+                Logger.Error(e, $@"Ritsu: could not save {file}.");
+            }
+        }
+    }
+}
diff --git a/osu.Game/LocalPriority/LocalBeatmapTagsDisplay.cs b/osu.Game/LocalPriority/LocalBeatmapTagsDisplay.cs
new file mode 100644
index 0000000000..198a2ccd3e
