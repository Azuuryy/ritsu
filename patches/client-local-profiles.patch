+        private static (double PP, int Rank)[]? rankCurve(string ruleset) => ruleset switch
+        {
+            @"osu" => osu_rank_curve,
+            @"taiko" => taiko_rank_curve,
+            @"fruits" => catch_rank_curve,
+            @"mania" => mania_rank_curve,
+            _ => null,
+        };
