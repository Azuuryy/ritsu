+++ b/osu.Game.Tests/NonVisual/LocalAutoSwitchConditionTest.cs
@@ -0,0 +1,86 @@
+// Copyright (c) 2026 Ritsu contributors. Licensed under the MIT Licence.
+using System.Collections.Generic;
+using Newtonsoft.Json;
+using NUnit.Framework;
+using osu.Game.Beatmaps;
+using osu.Game.LocalPriority;
+using osu.Game.Rulesets.Mods;
+
+namespace osu.Game.Tests.NonVisual
+{
+    [TestFixture]
+    public class LocalAutoSwitchConditionTest
+    {
+        [TestCase("180, 190", 180, true)]
+        [TestCase("180, 190", 190, true)]
+        [TestCase("180, 190", 185, false)]
+        [TestCase(">5", 5, false)]
+        [TestCase(">=5", 5, true)]
+        [TestCase("<7", 7, false)]
+        [TestCase("<=7", 7, true)]
+        [TestCase("=6", 6, true)]
+        [TestCase("6", 6.01, false)]
+        [TestCase("5-7", 6, true)]
+        [TestCase("5 - 7", 8, false)]
+        [TestCase("5+", 5, true)]
+        [TestCase("-7", 7.5, false)]
+        [TestCase(">5 <7", 6, true)]
+        [TestCase(">5 <7", 7, false)]
+        [TestCase("<100, >200", 250, true)]
+        [TestCase("<100, >200", 150, false)]
+        [TestCase("5.5", 5.5, true)]
+        [TestCase("≥ 4.25", 4.25, true)]
+        [TestCase("", 1, true)]
+        [TestCase("abc", 1, false)]
+        public void TestNumber(string condition, double value, bool expected) =>
+            Assert.That(LocalAutoSwitchCondition.MatchesNumber(condition, value), Is.EqualTo(expected));
+
+        [TestCase(">= 5 ,180", true, ">= 5, 180")]
+        [TestCase("x>5", false, "")]
+        [TestCase("5,5", true, "5, 5")]
+        [TestCase("5+ <3", true, "5+ <3")]
+        [TestCase(">+5", false, "")]
+        public void TestNormalise(string text, bool ok, string normalised)
+        {
+            Assert.That(LocalAutoSwitchCondition.TryNormaliseNumber(text, out string result, out _), Is.EqualTo(ok));
+            Assert.That(result, Is.EqualTo(normalised));
+        }
+
+        [Test]
+        public void TestRulesMatchBeatmap()
+        {
+            var beatmap = new BeatmapInfo { StarRating = 6.234, BPM = 179.97, Length = 95_900, DifficultyName = "Insane" };
+            beatmap.Metadata.Author.Username = "Sotarks";
+            beatmap.Metadata.Title = "Blue Zenith";
+
+            bool matches(LocalAutoSwitchRules r) => r.Matches(beatmap, new List<Mod>(), null);
+
+            Assert.That(matches(new LocalAutoSwitchRules { Bpm = "180, 190" }), Is.True, "BPM is shown as 180");
+            Assert.That(matches(new LocalAutoSwitchRules { Bpm = "170, 190" }), Is.False);
+            Assert.That(matches(new LocalAutoSwitchRules { Stars = ">6.2 <6.3" }), Is.True);
+            Assert.That(matches(new LocalAutoSwitchRules { Stars = "6.23" }), Is.True, "stars to two decimals");
+            Assert.That(matches(new LocalAutoSwitchRules { Length = "95" }), Is.True, "whole seconds");
+            Assert.That(matches(new LocalAutoSwitchRules { Length = "<95" }), Is.False);
+            Assert.That(matches(new LocalAutoSwitchRules { Mapper = "Monstrata, sotarks" }), Is.True);
+            Assert.That(matches(new LocalAutoSwitchRules { Mapper = "Monstrata, Mismagius" }), Is.False);
+            Assert.That(matches(new LocalAutoSwitchRules { Name = "freedom dive, zenith" }), Is.True);
+            Assert.That(matches(new LocalAutoSwitchRules { Name = "zenith", Bpm = ">200" }), Is.False, "every field has to match");
+        }
+
+        [Test]
+        public void TestOldSavedRulesAreUpgraded()
+        {
+            var rules = JsonConvert.DeserializeObject<LocalAutoSwitchRules>(
+                @"{""MinStars"":5.0,""MaxStars"":7.0,""MinBpm"":180.0,""MaxBpm"":null,""MinLength"":null,""MaxLength"":120.0,""Mapper"":""x""}")!;
+
+            Assert.That(rules.Stars, Is.EqualTo("5-7"));
+            Assert.That(rules.Bpm, Is.EqualTo(">=180"));
+            Assert.That(rules.Length, Is.EqualTo("<=120"));
+
+            string saved = JsonConvert.SerializeObject(rules);
+            Assert.That(saved, Does.Not.Contain("MinStars"));
+            Assert.That(JsonConvert.DeserializeObject<LocalAutoSwitchRules>(saved)!.Stars, Is.EqualTo("5-7"));
+            Assert.That(rules.Clone().Bpm, Is.EqualTo(">=180"));
+        }
+    }
+}
diff --git a/osu.Game.Tests/NonVisual/LocalDurableFileTest.cs b/osu.Game.Tests/NonVisual/LocalDurableFileTest.cs
new file mode 100644
index 0000000000..2f2069a68e
--- /dev/null
+++ b/osu.Game.Tests/NonVisual/LocalDurableFileTest.cs
@@ -0,0 +1,99 @@
+// Copyright (c) 2026 Ritsu contributors. Licensed under the MIT Licence.
+using System;
+using System.IO;
+using NUnit.Framework;
+using osu.Framework.Testing;
+using osu.Game.LocalPriority;
+
+namespace osu.Game.Tests.NonVisual
+{
+    [TestFixture]
+    public class LocalDurableFileTest
+    {
+        private TemporaryNativeStorage storage = null!;
+
+        [SetUp]
+        public void SetUp() => storage = new TemporaryNativeStorage($"local-durable-file-{Guid.NewGuid():N}");
+
+        [TearDown]
+        public void TearDown() => storage.Dispose();
+
+        private string read(string path) => LocalDurableFile.Read(storage, path, text => text)!;
+
+        private string contents(string path) => File.ReadAllText(storage.GetFullPath(path));
+
+        [Test]
+        public void TestMissingFileReadsAsNull()
+        {
+            Assert.That(LocalDurableFile.Read(storage, "data.json", text => text), Is.Null);
+        }
+
+        [Test]
+        public void TestSaveKeepsPreviousVersion()
+        {
+            LocalDurableFile.WriteText(storage, "data.json", "one");
+            LocalDurableFile.WriteText(storage, "data.json", "two");
+
+            Assert.That(read("data.json"), Is.EqualTo("two"));
+            Assert.That(contents("data.json" + LocalDurableFile.BACKUP_SUFFIX), Is.EqualTo("one"));
+            Assert.That(storage.GetFiles(string.Empty, "*.tmp"), Is.Empty);
+        }
+
+        [Test]
+        public void TestEmptyFileFallsBackToBackup()
+        {
+            LocalDurableFile.WriteText(storage, "data.json", "one");
+            LocalDurableFile.WriteText(storage, "data.json", "two");
+            File.WriteAllText(storage.GetFullPath("data.json"), string.Empty);
+
+            Assert.That(read("data.json"), Is.EqualTo("one"));
+            Assert.That(storage.Exists("data.json" + LocalDurableFile.BROKEN_SUFFIX), Is.True);
+
+            // Written back right away, so the next start finds it even if nothing is saved in between.
+            Assert.That(contents("data.json"), Is.EqualTo("one"));
+            Assert.That(contents("data.json" + LocalDurableFile.BACKUP_SUFFIX), Is.EqualTo("one"));
+        }
+
+        [Test]
+        public void TestMissingFileFallsBackToBackup()
+        {
+            LocalDurableFile.WriteText(storage, "data.json", "one");
+            LocalDurableFile.WriteText(storage, "data.json", "two");
+            File.Delete(storage.GetFullPath("data.json"));
+
+            Assert.That(read("data.json"), Is.EqualTo("one"));
+            Assert.That(contents("data.json"), Is.EqualTo("one"));
+        }
+
+        [Test]
+        public void TestEmptyFileNeverReplacesBackup()
+        {
+            LocalDurableFile.WriteText(storage, "data.json", "one");
+            File.WriteAllText(storage.GetFullPath("data.json"), string.Empty);
+            File.WriteAllText(storage.GetFullPath("data.json" + LocalDurableFile.BACKUP_SUFFIX), "good");
+
+            LocalDurableFile.WriteText(storage, "data.json", "two");
+
+            Assert.That(read("data.json"), Is.EqualTo("two"));
+            Assert.That(contents("data.json" + LocalDurableFile.BACKUP_SUFFIX), Is.EqualTo("good"));
+        }
+
+        [Test]
+        public void TestRejectedFileWithoutBackupStartsEmpty()
+        {
+            File.WriteAllText(storage.GetFullPath("data.json", true), "garbage");
+
+            Assert.That(LocalDurableFile.Read<string>(storage, "data.json", _ => throw new InvalidDataException()), Is.Null);
+            Assert.That(contents("data.json" + LocalDurableFile.BROKEN_SUFFIX), Is.EqualTo("garbage"));
+        }
+
+        [Test]
+        public void TestUnsupportedFileIsLeftAlone()
+        {
+            File.WriteAllText(storage.GetFullPath("data.json", true), "future");
+
+            Assert.Throws<NotSupportedException>(() => LocalDurableFile.Read<string>(storage, "data.json", _ => throw new NotSupportedException()));
+            Assert.That(contents("data.json"), Is.EqualTo("future"));
+        }
+    }
+}
