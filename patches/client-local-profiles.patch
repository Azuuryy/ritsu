+                        Children = new Drawable[]
+                        {
+                            new Container
+                            {
+                                Size = new Vector2(36),
+                                Anchor = Anchor.CentreLeft,
+                                Origin = Anchor.CentreLeft,
+                                Masking = true,
+                                CornerRadius = 5,
+                                Child = Avatar ?? Empty(),
+                            },
+                            new FillFlowContainer
+                            {
+                                AutoSizeAxes = Axes.Both,
+                                Anchor = Anchor.CentreLeft,
+                                Origin = Anchor.CentreLeft,
+                                Direction = FillDirection.Vertical,
+                                Children = new Drawable[]
+                                {
+                                    new FillFlowContainer
+                                    {
+                                        AutoSizeAxes = Axes.Both,
+                                        Direction = FillDirection.Horizontal,
+                                        Spacing = new Vector2(5, 0),
+                                        Children = new Drawable[]
+                                        {
+                                            new Container
+                                            {
+                                                Size = new Vector2(20, 14),
+                                                Anchor = Anchor.CentreLeft,
+                                                Origin = Anchor.CentreLeft,
+                                                Alpha = Flag == null ? 0 : 1,
+                                                Child = Flag ?? Empty(),
+                                            },
+                                            new OsuSpriteText
+                                            {
+                                                Anchor = Anchor.CentreLeft,
+                                                Origin = Anchor.CentreLeft,
+                                                Text = name,
+                                                Font = OsuFont.GetFont(size: 16, weight: FontWeight.SemiBold),
+                                            },
+                                        },
+                                    },
+                                    new FillFlowContainer
+                                    {
+                                        AutoSizeAxes = Axes.Both,
+                                        Direction = FillDirection.Horizontal,
+                                        Spacing = new Vector2(4, 0),
+                                        Children = new Drawable[]
+                                        {
+                                            new SpriteIcon
+                                            {
+                                                Icon = Icon,
+                                                Size = new Vector2(10),
+                                                Anchor = Anchor.CentreLeft,
+                                                Origin = Anchor.CentreLeft,
+                                                Colour = colours.Content2,
+                                            },
+                                            new OsuSpriteText
+                                            {
+                                                Anchor = Anchor.CentreLeft,
+                                                Origin = Anchor.CentreLeft,
+                                                Text = isActive ? $@"{kind} · active" : kind,
+                                                Font = OsuFont.GetFont(size: 12),
+                                                Colour = isActive ? osuColour.Lime1 : colours.Content2,
+                                            },
+                                        },
+                                    },
+                                },
+                            },
+                        },
+                    },
+                };
+
+                if (Delete != null)
+                {
+                    Add(new TrashButton
+                    {
+                        Anchor = Anchor.CentreRight,
+                        Origin = Anchor.CentreRight,
+                        Margin = new MarginPadding { Right = 8 },
+                        Action = Delete,
+                    });
+                }
+            }
+
+            protected override bool OnHover(HoverEvent e)
+            {
+                hover.FadeIn(100);
+                return base.OnHover(e);
+            }
+
+            protected override void OnHoverLost(HoverLostEvent e)
+            {
+                hover.FadeOut(200);
+                base.OnHoverLost(e);
+            }
+        }
+
+        /// <summary>
+        /// Dark with a white trash icon; on hover it grows a little and turns bright red.
+        /// </summary>
+        private partial class TrashButton : OsuClickableContainer
+        {
+            private Box background = null!;
+
+            private Color4 idleColour;
+            private Color4 hoverColour;
+
+            public TrashButton()
+            {
+                Size = new Vector2(30);
+                Masking = true;
+                CornerRadius = 5;
+                TooltipText = @"Delete profile";
+            }
+
+            [BackgroundDependencyLoader]
+            private void load(OsuColour osuColour)
+            {
+                idleColour = osuColour.Red.Darken(1.2f);
+                hoverColour = osuColour.Red.Lighten(0.2f);
+
+                Children = new Drawable[]
+                {
+                    background = new Box
+                    {
+                        RelativeSizeAxes = Axes.Both,
+                        Colour = idleColour,
+                    },
+                    new SpriteIcon
+                    {
+                        Anchor = Anchor.Centre,
+                        Origin = Anchor.Centre,
+                        Icon = FontAwesome.Solid.TrashAlt,
+                        Size = new Vector2(13),
+                        Colour = Color4.White,
+                    },
+                };
+            }
+
+            protected override bool OnHover(HoverEvent e)
+            {
+                this.ScaleTo(1.15f, 150, Easing.OutQuint);
+                background.FadeColour(hoverColour, 150, Easing.OutQuint);
+                return base.OnHover(e);
+            }
+
+            protected override void OnHoverLost(HoverLostEvent e)
+            {
+                this.ScaleTo(1, 250, Easing.OutQuint);
+                background.FadeColour(idleColour, 250, Easing.OutQuint);
+                base.OnHoverLost(e);
+            }
+        }
+    }
+}
diff --git a/osu.Game/LocalPriority/LocalProfileSyncDialog.cs b/osu.Game/LocalPriority/LocalProfileSyncDialog.cs
new file mode 100644
index 0000000000..0f97b734dc
--- /dev/null
+++ b/osu.Game/LocalPriority/LocalProfileSyncDialog.cs
@@ -0,0 +1,106 @@
+// Copyright (c) 2026 Ritsu contributors. Licensed under the MIT Licence.
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using osu.Framework.Graphics.Sprites;
+using osu.Framework.Logging;
+using osu.Game.Overlays;
+using osu.Game.Overlays.Dialog;
+
+namespace osu.Game.LocalPriority
+{
+    /// <summary>
+    /// "There already are plays saved under this name — sync them to this profile?"
+    /// Asked after a local profile is created or renamed, and from the profile chip's right-click menu.
+    /// Syncing only links the plays to the profile; the scores in the (shared) database are never changed.
+    /// </summary>
+    public partial class LocalProfileSyncDialog : PopupDialog
+    {
+        /// <summary>
+        /// Looks for plays saved under the profile's name and asks whether to sync them. Does nothing if there are none
+        /// (unless <paramref name="tellWhenNoneFound"/>, which shows a short note instead).
+        /// </summary>
+        public static void Offer(LocalProfileManager manager, IDialogOverlay? dialogs, Guid profileId, bool tellWhenNoneFound = false)
+        {
+            if (dialogs == null)
+                return;
+
+            // Settings → Ritsu: the automatic suggestion (after creating / renaming) can be turned off; asking from the menu always works.
+            if (!tellWhenNoneFound && !manager.SuggestSyncingSameNamePlays.Value)
+                return;
