+            using var cancellation = new CancellationTokenSource(TimeSpan.FromMinutes(5));
+            void cancel(Exception _) => cancellation.Cancel();
+            Failure += cancel;
+            string filename = Path.Combine(Path.GetTempPath(), Guid.NewGuid() + ".osz");
+            bool handedOff = false;
+            try
