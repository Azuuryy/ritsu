-          # month without leading zero
-          MONTH=$(date -u +%-m)
-          # day with leading zero
-          DAY=$(date -u +%d)
-          MDD="${MONTH}${DAY}"
-          BASE="${YEAR}.${MDD}"
-
-          # Branch decides the suffix:
-          #   master / main → -torii (stable)
-          #   nova          → -nova  (experimental, ships as prerelease)
-          # Anything else falls back to -torii defensively — a workflow_dispatch
-          # off a non-standard branch will still produce something sensible.
-          case "${GITHUB_REF_NAME}" in
-            nova) STREAM_SUFFIX="nova" ;;
