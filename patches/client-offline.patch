+      run: |
+        # Extract the top "## Latest" or "## <version>" section from
+        # CHANGELOG.md (everything from the first ## heading to the
+        # next ## or ---). If CHANGELOG.md is missing or has no
+        # section, fall back to a generic blurb so the release body
+        # never ends up empty.
