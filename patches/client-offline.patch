+name: Build Torii Nova
+
+on:
+  push:
+    branches: [ main, master, develop ]
+    tags: [ 'v*' ]
+  pull_request:
+    branches: [ main, master ]
+  workflow_dispatch:
+    inputs:
+      version:
+        description: 'Release version (e.g., 1.0.0)'
+        required: false
+        default: '1.0.0-dev'
+  release:
+    types: [ published ]
+
+env:
+  # Framework and resources are pinned to specific commit hashes so a
+  # toriirefresh release is fully reproducible. Bumping either forces a
+  # fresh CI run that picks up changes from the named repo at the named
+  # commit. toriirefresh uses the standard upstream graphics backend that
+  # ships with the framework via nuget.org — no extra fork to clone/pack,
+  # so restore resolves everything straight from nuget.org.
+  FRAMEWORK_REPOSITORY: 'ShikkesoraSIM/torii-framework'
+  FRAMEWORK_REF: '25e68d530f7116437c4cfaf127169ac4d6619927'
+  RESOURCES_REPOSITORY: 'ShikkesoraSIM/torii-resources'
+  RESOURCES_REF: '2a516e45ba416dbd2cf8b821661909109f738b34'
+
+jobs:
+  version:
+    name: Compute version
+    runs-on: ubuntu-latest
+    outputs:
+      version: ${{ steps.version.outputs.version }}
+      semver: ${{ steps.version.outputs.semver }}
+      assemblyVersion: ${{ steps.version.outputs.assemblyVersion }}
+      fileVersion: ${{ steps.version.outputs.fileVersion }}
+      androidVersionCode: ${{ steps.version.outputs.androidVersionCode }}
+    steps:
+    - name: Checkout (for commit count)
+      uses: actions/checkout@v4
+      with:
+        fetch-depth: 0
+    - name: Determine version
+      id: version
+      shell: bash
+      run: |
+        ANDROID_VERSION_CODE=$(python3 .github/scripts/android_release.py version-code "$GITHUB_RUN_NUMBER")
+        if [[ "${{ github.event_name }}" == "workflow_run" ]]; then
+          git fetch --tags --force
+          LAST_TAG=$(git tag -l 'v*' --sort=-creatordate | head -n1)
+          if [[ -n "$LAST_TAG" ]]; then
+            VERSION="$LAST_TAG"
+            SEMVER=${VERSION#v}
+            NUMERIC=${SEMVER%%-*}
+            PARTS=$(echo "$NUMERIC" | awk -F. '{print NF}')
+            if [[ $PARTS -eq 1 ]]; then NUMERIC="$NUMERIC.0.0.0"; fi
+            if [[ $PARTS -eq 2 ]]; then NUMERIC="$NUMERIC.0.0"; fi
+            if [[ $PARTS -eq 3 ]]; then NUMERIC="$NUMERIC.0"; fi
+            echo "version=$VERSION" >> $GITHUB_OUTPUT
+            echo "semver=$SEMVER" >> $GITHUB_OUTPUT
+            echo "assemblyVersion=$NUMERIC" >> $GITHUB_OUTPUT
+            echo "fileVersion=$NUMERIC" >> $GITHUB_OUTPUT
+            echo "androidVersionCode=$ANDROID_VERSION_CODE" >> $GITHUB_OUTPUT
+            echo "Computed version from latest tag (workflow_run): $VERSION (android: $ANDROID_VERSION_CODE)"
+            exit 0
+          fi
+        fi
+        if [[ "${{ github.event_name }}" == "release" ]]; then
+          VERSION="${{ github.event.release.tag_name }}"
+        elif [[ "${{ github.ref }}" == refs/tags/* ]]; then
+          VERSION="${{ github.ref_name }}"
+        elif [[ "${{ github.event_name }}" == "workflow_dispatch" ]] && [[ -n "${{ github.event.inputs.version }}" ]]; then
+          VERSION="${{ github.event.inputs.version }}"
+        elif [[ "${{ github.ref }}" == "refs/heads/main" ]] || [[ "${{ github.ref }}" == "refs/heads/master" ]]; then
+          COMMIT_COUNT=$(git rev-list --count HEAD)
+          BUILD_NUMBER=$((COMMIT_COUNT % 10000))
+          VERSION="1.0.$BUILD_NUMBER"
+        else
+          COMMIT_COUNT=$(git rev-list --count HEAD)
+          BUILD_NUMBER=$((COMMIT_COUNT % 10000))
+          VERSION="0.9.$BUILD_NUMBER"
+        fi
+
+        SEMVER=${VERSION#v}
+        NUMERIC=${SEMVER%%-*}
+        PARTS=$(echo "$NUMERIC" | awk -F. '{print NF}')
+        if [[ $PARTS -eq 1 ]]; then NUMERIC="$NUMERIC.0.0.0"; fi
+        if [[ $PARTS -eq 2 ]]; then NUMERIC="$NUMERIC.0.0"; fi
+        if [[ $PARTS -eq 3 ]]; then NUMERIC="$NUMERIC.0"; fi
+
+        echo "version=$VERSION" >> $GITHUB_OUTPUT
+        echo "semver=$SEMVER" >> $GITHUB_OUTPUT
+        echo "assemblyVersion=$NUMERIC" >> $GITHUB_OUTPUT
+        echo "fileVersion=$NUMERIC" >> $GITHUB_OUTPUT
+        
+        echo "androidVersionCode=$ANDROID_VERSION_CODE" >> $GITHUB_OUTPUT
+        
+        echo "Computed version: $VERSION (semver: $SEMVER, assembly/file: $NUMERIC, android: $ANDROID_VERSION_CODE)"
+
+  build:
+    name: Build ${{ matrix.runtime }} on ${{ matrix.os }}
+    needs: version
+    runs-on: ${{ matrix.os }}
+    timeout-minutes: 60
+    # Prevent concurrent builds from interfering with each other's NuGet operations
+    # un grupo por ref: si no, el CI de un push a la rama y el build de un tag pelean
+    # por el mismo grupo, y github cancela el que estaba esperando cuando entra un
+    # tercero (asi se perdio el build de la .823.4-nova: master + tag nova + tag torii
+    # en un minuto). por ref solo se deduplican pushes repetidos a la misma rama/tag.
+    concurrency:
+      group: build-${{ github.ref }}-${{ matrix.os }}-${{ matrix.runtime }}
+      cancel-in-progress: false
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          # `executable:` is the binary name produced by osu.Desktop.csproj
+          # (`AssemblyName = torii`).
+          #
+          # Android volvio a la matriz. Salio durante el apuro del debranding porque no
+          # estaba verificado el launcher, y ya lo esta: el paquete es
+          # sh.shikkesora.torii, el label "Torii Nova" y los mipmap ic_launcher son el
+          # torii, no el circulo de ellos. `executable` sigue diciendo osu.Android por el
+          # nombre del csproj, es un archivo intermedio del SDK; lo que se sube a la
+          # release es torii.apk.
+          - os: windows-latest
+            runtime: win-x64
+            artifact-name: torii-windows
+            executable: torii.exe
+          - os: windows-latest
+            runtime: win-arm64
+            artifact-name: torii-windows-arm64
+            executable: torii.exe
+          - os: ubuntu-latest
+            runtime: linux-x64
+            artifact-name: torii-linux
+            executable: torii
+          - os: ubuntu-latest
+            runtime: linux-arm64
+            artifact-name: torii-linux-arm64
+            executable: torii
+          - os: ubuntu-latest
+            runtime: osx-x64
+            artifact-name: torii-macos-intel
+            executable: torii
+          - os: ubuntu-latest
+            runtime: osx-arm64
+            artifact-name: torii-macos-apple-silicon
+            executable: torii
+          - os: ubuntu-latest
+            runtime: android
+            artifact-name: torii-android
+            executable: osu.Android-Signed.apk
+
+    steps:
+    - name: Checkout code
+      uses: actions/checkout@v4
+      with:
+        fetch-depth: 0
+        # Ensure we have complete git history for version calculation
+        # Use the release tag when triggered by a Release event, otherwise the triggering SHA
+        ref: ${{ github.event_name == 'release' && github.event.release.tag_name || github.sha }}
+
+    - name: Checkout framework dependency
+      uses: actions/checkout@v4
+      with:
+        repository: ${{ env.FRAMEWORK_REPOSITORY }}
+        fetch-depth: 1
+        ref: ${{ env.FRAMEWORK_REF }}
+        path: toriirefresh-framework
+
+    - name: Checkout resources dependency
+      uses: actions/checkout@v4
+      with:
+        repository: ${{ env.RESOURCES_REPOSITORY }}
+        fetch-depth: 1
+        ref: ${{ env.RESOURCES_REF }}
+        path: toriirefresh-resources
+
+    - name: Place dependencies in expected sibling paths
+      shell: bash
+      run: |
+        rm -rf ../toriirefresh-framework ../toriirefresh-resources
+        mv toriirefresh-framework ../toriirefresh-framework
+        mv toriirefresh-resources ../toriirefresh-resources
+
+    - name: Setup .NET
+      # Install both .NET 10 (required by global.json + net10.0-android
+      # + CoreCLR runtime) and .NET 8 (kept around so any tooling that
+      # still hard-codes 8.x — e.g. legacy MSBuild tasks during the
+      # transition — keeps working).
+      uses: actions/setup-dotnet@v4
+      with:
+        dotnet-version: |
+          8.0.x
+          10.0.x
+
+    - name: Setup Java for Android (Android only)
+      if: matrix.runtime == 'android'
+      uses: actions/setup-java@v4
+      with:
+        distribution: 'microsoft'
+        java-version: '17'
+
+    - name: Setup Android SDK (Android only)
+      if: matrix.runtime == 'android'
+      uses: android-actions/setup-android@v3
+      with:
+        cmdline-tools-version: 8512546
+        # the default also asks for 'tools', which google removed from the sdk repo (2026-10) and
+        # makes sdkmanager exit 1. the runner image already has platforms and build-tools.
+        packages: platform-tools
+
+    - name: Accept Android SDK licenses (Android only)
+      if: matrix.runtime == 'android'
+      shell: bash
+      run: |
+        yes | $ANDROID_SDK_ROOT/cmdline-tools/latest/bin/sdkmanager --licenses || true
+
+    - name: Install Android workload (Android only)
+      if: matrix.runtime == 'android'
+      shell: bash
+      run: |
+        dotnet workload install android --version 10.0.402
+        dotnet workload list
+        echo "Android SDK Root: $ANDROID_SDK_ROOT"
+        echo "Java Home: $JAVA_HOME"
+
+    - name: Install Velopack CLI
+      shell: bash
+      run: dotnet tool install -g vpk
+
+    - name: Create macOS icon (macOS only)
+      if: startsWith(matrix.os, 'macos-')
+      continue-on-error: true
+      shell: bash
+      run: |
+        # torii.icns is checked in at repo root (osu.Desktop/torii.icns) —
+        # generated from torii-lazer-web/public/image/logos/torii-512.png
+        # using Pillow's ICNS writer. If for some reason it's missing
+        # (e.g. someone runs CI from a branch that pre-dates the icon
+        # commit), fall back to converting torii.ico via sips + iconutil,
+        # mirroring the pre-rebrand lazer.ico → lazer.icns flow.
+        if [ -f "osu.Desktop/torii.icns" ] && [ -s "osu.Desktop/torii.icns" ]; then
+          echo "torii.icns already present in repo — skipping generation."
+          exit 0
+        fi
+
+        if [ -f "osu.Desktop/torii.ico" ]; then
+          echo "Generating torii.icns from torii.ico..."
+          sips -s format png osu.Desktop/torii.ico --out temp_icon.png || {
+            cp osu.Desktop/torii.ico osu.Desktop/torii.icns
+            echo "sips conversion failed, using .ico as macOS fallback"
+            exit 0
+          }
+
+          mkdir -p torii.iconset
+          sips -z 16 16     temp_icon.png --out torii.iconset/icon_16x16.png
+          sips -z 32 32     temp_icon.png --out torii.iconset/icon_16x16@2x.png
+          sips -z 32 32     temp_icon.png --out torii.iconset/icon_32x32.png
+          sips -z 64 64     temp_icon.png --out torii.iconset/icon_32x32@2x.png
+          sips -z 128 128   temp_icon.png --out torii.iconset/icon_128x128.png
+          sips -z 256 256   temp_icon.png --out torii.iconset/icon_128x128@2x.png
+          sips -z 256 256   temp_icon.png --out torii.iconset/icon_256x256.png
+          sips -z 512 512   temp_icon.png --out torii.iconset/icon_256x256@2x.png
+          sips -z 512 512   temp_icon.png --out torii.iconset/icon_512x512.png
+          cp torii.iconset/icon_512x512.png torii.iconset/icon_512x512@2x.png
+
+          iconutil -c icns torii.iconset || {
+            cp osu.Desktop/torii.ico osu.Desktop/torii.icns
+            rm -f temp_icon.png
+            rm -rf torii.iconset
+            exit 0
+          }
+
+          cp torii.icns osu.Desktop/torii.icns
+          rm -f temp_icon.png
+          rm -rf torii.iconset
+          echo "Generated torii.icns successfully"
+        else
+          echo "Warning: torii.ico not found, creating placeholder icns"
+          touch osu.Desktop/torii.icns
+        fi
+
+    - name: Cache NuGet packages
+      uses: actions/cache@v4
+      with:
+        path: |
+          ~/.nuget/packages
+          ~/.local/share/NuGet/v3-cache
+          ~/.cache/NuGet/v3-cache
+        key: ${{ runner.os }}-${{ matrix.runtime }}-nuget-${{ hashFiles('**/*.csproj', '**/packages.lock.json', 'nuget.config') }}
+        restore-keys: |
+          ${{ runner.os }}-${{ matrix.runtime }}-nuget-${{ hashFiles('**/*.csproj') }}
+          ${{ runner.os }}-${{ matrix.runtime }}-nuget-
+          ${{ runner.os }}-nuget-
+
+    - name: Show version
+      shell: bash
+      run: |
+        echo "Building version: ${{ needs.version.outputs.version }} (semver: ${{ needs.version.outputs.semver }}, assembly/file: ${{ needs.version.outputs.fileVersion }}, android: ${{ needs.version.outputs.androidVersionCode }})"
+
+    - name: Clean previous build artifacts
+      shell: bash
+      run: |
+        echo "Cleaning previous build artifacts for ${{ matrix.runtime }}"
+        if [[ "${{ matrix.runtime }}" == "android" ]]; then
+          rm -rf osu.Android/bin osu.Android/obj
+        else
+          rm -rf osu.Desktop/bin osu.Desktop/obj
+        fi
+        rm -rf publish/${{ matrix.runtime }}
+
+    - name: Restore dependencies for specific runtime
+      timeout-minutes: 15
+      shell: bash
+      run: |
+        echo "Restoring packages for runtime: ${{ matrix.runtime }}"
+        if [[ "${{ matrix.runtime }}" == "android" ]]; then
+          dotnet restore osu.Android/osu.Android.csproj \
+            --verbosity normal \
+            --configfile nuget.config \
+            --no-cache \
+            --force
+        else
+          dotnet restore osu.Desktop/osu.Desktop.csproj \
+            --runtime ${{ matrix.runtime }} \
+            --verbosity normal \
+            --configfile nuget.config \
+            --no-cache \
+            --force
+        fi
+
+    - name: Setup Android signing (Android only)
+      if: matrix.runtime == 'android'
+      shell: bash
+      env:
+        ANDROID_KEYSTORE_BASE64: ${{ secrets.ANDROID_KEYSTORE_BASE64 }}
+        ANDROID_KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
+        ANDROID_KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
+        ANDROID_KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}
+      run: |
+        echo "Setting up Android keystore for signing..."
+        # Use the base64-encoded keystore from secrets when available.
+        if [[ -n "$ANDROID_KEYSTORE_BASE64" ]]; then
+          echo "Using keystore from GitHub Secrets"
+          echo "$ANDROID_KEYSTORE_BASE64" | base64 -d > osu.keystore
+          
+          # Verify decoded keystore file.
+          if [[ ! -f "osu.keystore" ]] || [[ ! -s "osu.keystore" ]]; then
+            echo "ERROR: Failed to decode keystore from base64"
+            exit 1
+          fi
+          
+          # Verify keystore credentials.
+          if [[ -z "$ANDROID_KEYSTORE_PASSWORD" ]] || [[ -z "$ANDROID_KEY_ALIAS" ]] || [[ -z "$ANDROID_KEY_PASSWORD" ]]; then
+            echo "ERROR: Android signing secrets are incomplete!"
+            echo "Required secrets: ANDROID_KEYSTORE_BASE64, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD"
+            exit 1
+          fi
+          
+          # Validate keystore access.
+          echo "Verifying keystore integrity..."
+          keytool -list -keystore osu.keystore -storepass "$ANDROID_KEYSTORE_PASSWORD" -alias "$ANDROID_KEY_ALIAS" || {
+            echo "ERROR: Cannot access keystore with provided credentials"
+            exit 1
+          }
+          
+          echo "Keystore setup successful"
+        else
+          echo "No keystore found in secrets, creating temporary one..."
+          keytool -genkey -v \
+            -keystore osu.keystore \
+            -keyalg RSA \
+            -keysize 2048 \
+            -validity 10000 \
+            -alias osu \
+            -storepass temp123 \
+            -keypass temp123 \
+            -dname "CN=osu-torii-temp,OU=osu-torii,O=osu-torii,L=Unknown,S=Unknown,C=Unknown"
+          echo "WARNING: Using temporary keystore! Please configure ANDROID_KEYSTORE_BASE64 secret for production builds."
+        fi
+
+    - name: Build and publish
+      shell: bash
+      env:
+        ANDROID_KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
+        ANDROID_KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
+        ANDROID_KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}
+        ANDROID_KEYSTORE_BASE64: ${{ secrets.ANDROID_KEYSTORE_BASE64 }}
+      run: |
+        echo "Building for runtime: ${{ matrix.runtime }}"
+        if [[ "${{ matrix.runtime }}" == "android" ]]; then
+          # Build Android APK
+          # Prefer signing values from secrets, fallback to temporary defaults.
+          KEYSTORE_PASS="${ANDROID_KEYSTORE_PASSWORD:-temp123}"
+          KEY_ALIAS="${ANDROID_KEY_ALIAS:-osu}"
+          KEY_PASS="${ANDROID_KEY_PASSWORD:-temp123}"
+          
+          echo "Using Java version: $(java -version 2>&1 | head -n 1)"
+          echo "Android SDK Root: $ANDROID_SDK_ROOT"
+          echo "Keystore file exists: $(test -f osu.keystore && echo 'Yes' || echo 'No')"
+          echo "Using key alias: $KEY_ALIAS"
+          
+          # Ensure keystore exists before publish.
+          if [[ ! -f "osu.keystore" ]]; then
+            echo "ERROR: Keystore file not found!"
+            exit 1
+          fi
+          
+          dotnet publish osu.Android/osu.Android.csproj \
+            --configuration Release \
+            --verbosity normal \
+            --no-restore \
+            -p:Version=${{ needs.version.outputs.semver }} \
+            -p:ApplicationVersion=${{ needs.version.outputs.androidVersionCode }} \
+            -p:ApplicationDisplayVersion=${{ needs.version.outputs.semver }} \
+            -p:AndroidSdkDirectory=$ANDROID_SDK_ROOT \
+            -p:AndroidKeyStore=true \
+            -p:AndroidSigningKeyStore=../osu.keystore \
+            -p:AndroidSigningKeyAlias="$KEY_ALIAS" \
+            -p:AndroidSigningKeyPass="$KEY_PASS" \
+            -p:AndroidSigningStorePass="$KEYSTORE_PASS" \
+            -p:AndroidPackageFormat=apk
+          
+          # Create output directory and copy APK
+          mkdir -p "publish/${{ matrix.runtime }}"
+
+          # Find the candidate APK. Prefer a *-Signed.apk if dotnet publish
+          # produced one (the historical Xamarin / Mono path), but accept
+          # any .apk otherwise — under .NET 10 + CoreCLR-experimental the
+          # build sometimes drops only an unsigned APK and we'll sign it
+          # explicitly below.
+          ALL_APKS=$(find osu.Android/bin/Release/ -name "*.apk" 2>/dev/null || true)
+          if [[ -z "$ALL_APKS" ]]; then
+            echo "ERROR: No APK file found after build!"
+            find osu.Android/bin/Release/ -type f 2>&1 | head -50 || true
+            exit 1
+          fi
+
+          APK_FILE=$(echo "$ALL_APKS" | grep -- '-Signed.apk' | head -1)
+          if [[ -z "$APK_FILE" ]]; then
+            APK_FILE=$(echo "$ALL_APKS" | head -1)
+            echo "No -Signed.apk found; using $APK_FILE and signing it explicitly below."
+          else
+            echo "Using pre-signed APK: $APK_FILE"
+          fi
+
+          # ===================================================================
+          # Patch wrong native libs (Linux variants of bass/ffmpeg) with the
+          # Android-bionic ones from osu.Framework.Android/arm64-v8a/.
+          # ===================================================================
+          # Why: under .NET 10 + CoreCLR runtime, the .NET RID resolver falls
+          # back from android-arm64 to linux-arm64 when looking for native
+          # libs in the ppy.osu.Framework.NativeLibs package (which has an
+          # empty runtimes/android/native/ folder). The Linux libbass.so
+          # links to libc.so.6 / libasound.so.2 — names that don't exist on
+          # Android's bionic libc — so dlopen fails the moment osu! tries
+          # to load audio. Result: app dies during BASS init with
+          # "library libc.so.6 not found", before the welcome screen ever
+          # paints.
+          #
+          # Mono runtime did NOT have this problem because its native lib
+          # resolution didn't fall back to linux-arm64 for android-arm64.
+          # CoreCLR-Android does (it shares the desktop CoreCLR resolver).
+          #
+          # Fix: the framework's checkout has the CORRECT Android-bionic
+          # builds at osu.Framework.Android/arm64-v8a/lib*.so — those use
+          # libc.so / libaaudio.so / libmediandk.so (all bionic). We
+          # extract the APK, replace the wrong libs with the right ones,
+          # and re-pack. The downstream zipalign + apksigner steps then
+          # produce a correctly-signed APK that loads audio cleanly.
+          # ===================================================================
+          BIONIC_LIBS_SRC="../toriirefresh-framework/osu.Framework.Android/arm64-v8a"
+          if [[ -d "$BIONIC_LIBS_SRC" ]] && compgen -G "$BIONIC_LIBS_SRC/*.so" > /dev/null; then
+            PATCH_DIR="$(mktemp -d)"
+            echo "Patching APK native libs from $BIONIC_LIBS_SRC into $PATCH_DIR"
+            ( cd "$PATCH_DIR" && unzip -q "$GITHUB_WORKSPACE/$APK_FILE" )
+            mkdir -p "$PATCH_DIR/lib/arm64-v8a"
+            for so in "$BIONIC_LIBS_SRC"/*.so; do
+              name=$(basename "$so")
+              echo "  -> overwriting lib/arm64-v8a/$name with bionic build"
+              cp -f "$so" "$PATCH_DIR/lib/arm64-v8a/$name"
+            done
+            # Strip any stale signing files; the upcoming apksigner pass
+            # writes a fresh v2/v3 block.
+            rm -rf "$PATCH_DIR/META-INF/CERT.RSA" "$PATCH_DIR/META-INF/CERT.SF" "$PATCH_DIR/META-INF/MANIFEST.MF" 2>/dev/null || true
+            REPACKED="$GITHUB_WORKSPACE/${APK_FILE%.apk}-bionic.apk"
+            # -0 (store, no compression) for the WHOLE archive. Android
+            # target SDK 30+ requires resources.arsc to be uncompressed
+            # and 4-byte aligned, and .so files have always preferred
+            # being uncompressed so the OS can mmap them directly. Using
+            # -0 across the board sidesteps having to enumerate which
+            # entries can/can't be compressed; zipalign -p -f -v 4
+            # below then sets the page-alignment that the runtime mmap
+            # path expects. APK size grows ~5-10% vs a compressed pack
+            # — acceptable cost for a guaranteed-installable APK.
+            ( cd "$PATCH_DIR" && zip -qrX0 "$REPACKED" . )
+            APK_FILE="${REPACKED#$GITHUB_WORKSPACE/}"
+            echo "Repacked APK: $APK_FILE"
+            # Quick sanity check: confirm libbass.so in the new APK does
+            # NOT depend on libc.so.6.
+            if unzip -p "$APK_FILE" lib/arm64-v8a/libbass.so 2>/dev/null | grep -aoF 'libc.so.6' >/dev/null; then
+              echo "::error::Patched APK still references libc.so.6 in libbass.so"
+              exit 1
+            fi
+            echo "Verified: bass libs are bionic-compatible (no libc.so.6 dep)."
+          else
+            echo "::warning::Could not find $BIONIC_LIBS_SRC/*.so — APK may ship Linux libbass.so and crash on Android"
+          fi
+
+          # Locate apksigner from the Android SDK build-tools. We need it
+          # both to (re-)sign the APK if dotnet publish skipped that
+          # step under CoreCLR, and to verify the result before we ship
+          # an unsigned APK that Android will refuse to install with the
+          # generic "App not installed" dialog.
+          APKSIGNER=$(find "$ANDROID_SDK_ROOT/build-tools" -maxdepth 2 -name apksigner 2>/dev/null | sort -V | tail -1)
+          if [[ -z "$APKSIGNER" ]]; then
+            echo "ERROR: apksigner not found under $ANDROID_SDK_ROOT/build-tools"
+            ls -la "$ANDROID_SDK_ROOT/build-tools" 2>&1 || true
+            exit 1
+          fi
+          echo "Using apksigner: $APKSIGNER"
+
+          # ZIP-align before signing. Required for v2+ signature schemes;
+          # the SDK's APK build path normally aligns automatically, but
+          # if the CoreCLR path skipped both alignment and signing we
+          # need to redo both. zipalign is in the same build-tools
+          # directory as apksigner.
+          ZIPALIGN=$(dirname "$APKSIGNER")/zipalign
+          if [[ -x "$ZIPALIGN" ]]; then
+            ALIGNED_APK="${APK_FILE%.apk}-aligned.apk"
+            "$ZIPALIGN" -p -f -v 4 "$APK_FILE" "$ALIGNED_APK" >/dev/null 2>&1 || {
+              echo "zipalign failed; continuing with original APK"
+              cp "$APK_FILE" "$ALIGNED_APK"
+            }
+            APK_FILE="$ALIGNED_APK"
+          fi
+
+          # Sign (or re-sign) the APK with the keystore we set up earlier.
+          # apksigner is idempotent — if the APK is already signed with
+          # the same key, this just rewrites the same signature; if it
+          # isn't signed at all, this adds v2+v3 signatures. Either way
+          # we end up with a signed APK Android will accept.
+          echo "Signing APK with apksigner..."
+          "$APKSIGNER" sign \
+            --ks osu.keystore \
+            --ks-pass "pass:$KEYSTORE_PASS" \
+            --ks-key-alias "$KEY_ALIAS" \
+            --key-pass "pass:$KEY_PASS" \
+            --v1-signing-enabled true \
+            --v2-signing-enabled true \
+            --v3-signing-enabled true \
+            "$APK_FILE"
+
+          # Hard-fail if the APK still isn't signed after our explicit
+          # signing pass. Without this the workflow would happily ship an
+          # unsigned APK and users would hit "App not installed" the
+          # moment they sideload.
+          echo "Verifying APK signature..."
+          "$APKSIGNER" verify --verbose "$APK_FILE" || {
+            echo "ERROR: APK signature verification failed after explicit signing!"
+            exit 1
+          }
+
+          echo "Found APK: $APK_FILE"
+          cp "$APK_FILE" "publish/${{ matrix.runtime }}/${{ matrix.executable }}"
+
+          # Optionally inspect resulting APK metadata.
+          if command -v aapt2 &> /dev/null; then
+            echo "Inspecting APK metadata..."
+            aapt2 dump badging "publish/${{ matrix.runtime }}/${{ matrix.executable }}" | grep -E "application-label|package" || true
+          fi
+        else
+          # Desktop build
+          dotnet publish osu.Desktop/osu.Desktop.csproj \
+            --self-contained \
+            --runtime ${{ matrix.runtime }} \
+            --configuration Release \
+            --output "publish/${{ matrix.runtime }}" \
+            --no-restore \
+            --verbosity normal \
+            -p:PublishSingleFile=false \
+            -p:PublishTrimmed=false \
+            -p:Version=${{ needs.version.outputs.semver }} \
+            -p:FileVersion=${{ needs.version.outputs.fileVersion }} \
+            -p:AssemblyVersion=${{ needs.version.outputs.assemblyVersion }} \
+            -p:InformationalVersion=${{ needs.version.outputs.version }}
+        fi
+
+    - name: Attach Satori GC (net10 desktop)
+      # Overlay the Satori low-pause GC runtime onto the published self-contained
+      # build, replacing the stock coreclr / clrjit / System.Private.CoreLib with
+      # Satori's. Satori is what collapses the song-select GC pauses (gen2 281 -> 16
+      # on net10 in an A/B allocation test), the same win osu ships on net8.
+      #
+      # net10 Satori has NO public release (only expiring CI artifacts from
+      # ppy/Satori's 10.0-based branch), so the runtime files are vendored in-repo
+      # under satori-runtime/net10/<rid>.zip and just unzipped in place here - no
+      # download, no auth, no expiry. Built from ppy/Satori 10.0-based run
+      # 27126600038 (.NET 10.0.4 coreclr; patch-compatible with the net10.0.x BCL
+      # the SDK publishes). Same overlay shape osu-deploy uses for net8.
+      if: matrix.runtime != 'android'
+      shell: bash
+      run: |
+        RID="${{ matrix.runtime }}"
+        PUBLISH_DIR="publish/$RID"
+        ZIP="satori-runtime/net10/$RID.zip"
+
+        if [[ ! -f "$ZIP" ]]; then
+          echo "No vendored Satori for runtime '$RID' - leaving stock GC in place."
+          exit 0
+        fi
+
+        # Satori here is net10-only; never overlay it onto a non-net10 build.
+        RCFG=$(ls "$PUBLISH_DIR"/*.runtimeconfig.json 2>/dev/null | head -1)
+        if [[ -n "$RCFG" ]] && ! grep -q 'net10' "$RCFG"; then
+          echo "Publish output is not net10 - skipping net10 Satori overlay."
+          exit 0
+        fi
+
+        # Overwrite the stock runtime files in place (coreclr/clrjit are named
+        # .dll on Windows, .so on Linux, .dylib on macOS; System.Private.CoreLib
+        # is .dll everywhere). -j flattens, -o overwrites.
+        unzip -o -j "$ZIP" -d "$PUBLISH_DIR" || { echo "::error::Failed to extract vendored Satori for ${RID}"; exit 1; }
+
+        test -f "$PUBLISH_DIR/System.Private.CoreLib.dll" || { echo "::error::Satori overlay missing System.Private.CoreLib.dll for ${RID}"; exit 1; }
+        ls "$PUBLISH_DIR"/*coreclr* >/dev/null 2>&1 || { echo "::error::Satori overlay missing coreclr for ${RID}"; exit 1; }
+        echo "Vendored net10 Satori overlaid into ${PUBLISH_DIR}."
+        ls -la "$PUBLISH_DIR"/System.Private.CoreLib.dll "$PUBLISH_DIR"/*coreclr* "$PUBLISH_DIR"/*clrjit* 2>/dev/null || true
+
+    - name: Resolve desktop executable name
+      if: matrix.runtime != 'android'
+      shell: bash
+      run: |
+        PUBLISH_DIR="publish/${{ matrix.runtime }}"
+        EXPECTED="${{ matrix.executable }}"
+        RESOLVED="$EXPECTED"
+
+        if [[ ! -f "$PUBLISH_DIR/$EXPECTED" ]]; then
+          echo "Expected executable missing: $PUBLISH_DIR/$EXPECTED"
+          CANDIDATE=""
+
+          if [[ "${{ matrix.os }}" == "windows-latest" ]]; then
+            for f in "$PUBLISH_DIR"/*.exe; do
+              if [[ -f "$f" ]]; then
+                CANDIDATE="$f"
+                break
+              fi
+            done
+          else
+            for f in "$PUBLISH_DIR"/*; do
+              [[ -f "$f" ]] || continue
+              name=$(basename "$f")
+              [[ "$name" == osu* ]] || continue
+              [[ "$name" == *.dll ]] && continue
+              [[ "$name" == *.deps.json ]] && continue
+              [[ "$name" == *.runtimeconfig.json ]] && continue
+              CANDIDATE="$f"
+              break
+            done
+
+            if [[ -z "$CANDIDATE" ]]; then
+              for f in "$PUBLISH_DIR"/*; do
+                if [[ -f "$f" ]]; then
+                  CANDIDATE="$f"
+                  break
+                fi
+              done
+            fi
+          fi
+
+          if [[ -n "$CANDIDATE" ]]; then
+            RESOLVED=$(basename "$CANDIDATE")
+            echo "Resolved executable fallback: $RESOLVED"
+          else
+            echo "Unable to locate executable in $PUBLISH_DIR"
+            ls -la "$PUBLISH_DIR" || true
+            exit 1
+          fi
+        fi
+
+        echo "RESOLVED_EXECUTABLE=$RESOLVED" >> "$GITHUB_ENV"
+
+    - name: Set executable permissions (Linux/macOS)
+      if: (matrix.os == 'ubuntu-latest' || startsWith(matrix.os, 'macos-')) && matrix.runtime != 'android'
+      shell: bash
+      run: chmod +x "publish/${{ matrix.runtime }}/${RESOLVED_EXECUTABLE}"
+
+    - name: Compute osu.Game.dll MD5 hash
+      if: matrix.runtime != 'android'
+      shell: bash
+      run: |
+        # IMPORTANT: hash osu.Game.dll, NOT the bootstrapper executable.
+        #
+        # The runtime checks `typeof(OsuGameBase).Assembly.Location` and
+        # md5s THAT file (osu.Game.dll), then ships it to the spectator
+        # as version_hash. The previous CI revision hashed the .NET host
+        # bootstrapper (`torii.exe` on Windows, `torii` on Linux, the
+        # .app exe on macOS — pre-rebrand these were `osu-torii.exe` and
+        # `osu-torii`), which is a DIFFERENT file with a DIFFERENT md5
+        # — so every Torii build registered with the server was
+        # unrecognised on connect. The "Playing on Torii Nova client"
+        # badge was permanently invisible for everyone, which is the
+        # bug Shikkesora reported on 2026-05-03.
+        #
+        # osu.Game.dll lives next to the bootstrapper in the publish
+        # folder. The host varies per runtime; the assembly does not.
+        ASSEMBLY="publish/${{ matrix.runtime }}/osu.Game.dll"
+        if [[ ! -f "$ASSEMBLY" ]]; then
+          echo "::warning::osu.Game.dll not found at $ASSEMBLY — hash will not be registered"
+          HASH=""
+        elif command -v md5sum &>/dev/null; then
+          HASH=$(md5sum "$ASSEMBLY" | cut -d' ' -f1 | tr '[:upper:]' '[:lower:]')
+        elif command -v md5 &>/dev/null; then
+          HASH=$(md5 -q "$ASSEMBLY" | tr '[:upper:]' '[:lower:]')
+        else
+          echo "::warning::No md5 tool found on this runner — hash will not be registered"
+          HASH=""
+        fi
+
+        case "${{ matrix.runtime }}" in
+          win-x64|win-arm64) OS_LABEL="Windows" ;;
+          linux-x64|linux-arm64) OS_LABEL="Linux" ;;
+          osx-x64|osx-arm64) OS_LABEL="macOS" ;;
+          *) OS_LABEL="${{ matrix.runtime }}" ;;
+        esac
+
+        mkdir -p hash-output
+        printf '{"hash":"%s","os":"%s","runtime":"%s"}' "$HASH" "$OS_LABEL" "${{ matrix.runtime }}" \
+          > "hash-output/hash-${{ matrix.runtime }}.json"
+        echo "Hash for ${{ matrix.runtime }} (osu.Game.dll): $HASH ($OS_LABEL)"
+
+    - name: Compute Android string-based version hash
+      # Android takes a different code path because osu.Game.dll inside the
+      # APK is unreadable (packed). OsuGameBase.cs catches the IOException and
+      # falls back to MD5("{Version}-{RuntimeInfo.OS}") — see osu.Game/OsuGameBase.cs
+      # ~line 403. So the registered hash for Android is the MD5 of the literal
+      # string "{version}-Android", not a binary hash.
+      #
+      # Without this step, Android clients ALWAYS fail the spectator's
+      # client-name lookup → no "Torii client" badge for any Android user.
+      # Bug discovered 2026-05-11 when Shikkesora's Pixel showed unbadged in
+      # her own friend list. Running it as a separate step (instead of
+      # branching the desktop step) keeps the desktop hash logic untouched.
+      if: matrix.runtime == 'android'
+      shell: bash
+      run: |
+        VERSION="${{ needs.version.outputs.semver }}"
+        HASH=$(python3 .github/scripts/android_release.py version-hash "$VERSION")
+
+        mkdir -p hash-output
+        printf '{"hash":"%s","os":"%s","runtime":"%s"}' "$HASH" "Android" "android" \
+          > "hash-output/hash-android.json"
+        echo "Hash for android (ApplicationDisplayVersion '${VERSION}'): $HASH"
+
+    - name: Upload hash artifact
+      uses: actions/upload-artifact@v4
+      with:
+        name: hash-${{ matrix.runtime }}-${{ needs.version.outputs.version }}
+        path: hash-output/hash-${{ matrix.runtime }}.json
+        retention-days: 30
+
+    - name: Drop XML docs from the publish
+      if: matrix.runtime != 'android'
+      shell: bash
+      run: |
+        # 4,6 MB de comentarios en texto plano al lado del exe que no sirven en
+        # runtime, y varios replican texto de UI de upstream.
+        find "publish/${{ matrix.runtime }}" -maxdepth 1 -name '*.xml' -delete || true
+
+    - name: Create Velopack package
+      if: matrix.runtime != 'android'
+      shell: bash
+      run: |
+        if [[ "${{ matrix.runtime }}" == osx-* ]] && [[ "${{ matrix.os }}" != macos* ]]; then
+          # Cross-building macOS on Linux: vpk can't bundle here, so the .app is
+          # assembled by hand. A bundle is just a folder layout plus Info.plist;
+          # the old "zip of loose files" was what made every Mac user need
+          # terminal help to get it running.
+          mkdir -p Releases
+          ZIP_NAME="Torii-macOS-Intel.zip"
+          MIN_OS="10.15"
+          if [[ "${{ matrix.runtime }}" == "osx-arm64" ]]; then
+            ZIP_NAME="Torii-macOS-AppleSilicon.zip"
+            MIN_OS="11.0"
+          fi
+
+          STAGE="bundle-${{ matrix.runtime }}"
+          APP="$STAGE/Torii.app"
+          rm -rf "$STAGE"
+          mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
+
+          cp -R "publish/${{ matrix.runtime }}/." "$APP/Contents/MacOS/"
+          chmod +x "$APP/Contents/MacOS/${RESOLVED_EXECUTABLE}"
+
+          if [ -s osu.Desktop/torii.icns ]; then
+            cp osu.Desktop/torii.icns "$APP/Contents/Resources/torii.icns"
+          fi
+
+          cat > "$APP/Contents/Info.plist" <<PLIST
+        <?xml version="1.0" encoding="UTF-8"?>
+        <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+        <plist version="1.0">
+        <dict>
+          <key>CFBundleName</key><string>Torii</string>
+          <key>CFBundleDisplayName</key><string>Torii</string>
+          <key>CFBundleIdentifier</key><string>com.shikkesora.torii</string>
+          <key>CFBundleExecutable</key><string>${RESOLVED_EXECUTABLE}</string>
+          <key>CFBundleIconFile</key><string>torii.icns</string>
+          <key>CFBundlePackageType</key><string>APPL</string>
+          <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
+          <key>CFBundleShortVersionString</key><string>${{ needs.version.outputs.semver }}</string>
+          <key>CFBundleVersion</key><string>${{ needs.version.outputs.fileVersion }}</string>
+          <key>LSMinimumSystemVersion</key><string>${MIN_OS}</string>
+          <key>LSApplicationCategoryType</key><string>public.app-category.games</string>
+          <key>NSHighResolutionCapable</key><true/>
+          <key>NSSupportsAutomaticGraphicsSwitching</key><true/>
+          <key>CFBundleURLTypes</key>
+          <array>
+            <dict>
+              <key>CFBundleURLName</key><string>osu! links</string>
+              <key>CFBundleURLSchemes</key><array><string>osu</string><string>osump</string></array>
+            </dict>
+          </array>
+        </dict>
+        </plist>
+        PLIST
+          # el heredoc va indentado por el yaml; sacarle la sangria para que quede un plist limpio
+          sed -i 's/^        //' "$APP/Contents/Info.plist"
+          printf 'APPL????' > "$APP/Contents/PkgInfo"
+
+          cp "osu.Desktop/macos-package/Install Torii.command" "$STAGE/Install Torii.command"
+          cp osu.Desktop/macos-package/README.txt "$STAGE/README.txt"
+          chmod +x "$STAGE/Install Torii.command"
+
+          # -y keeps symlinks, and unix permissions travel inside the zip so the
+          # executable bit survives Archive Utility on the other side.
+          (
+            cd "$STAGE"
+            zip -r -y "../Releases/${ZIP_NAME}" .
+          )
+        elif [[ "${{ matrix.runtime }}" == osx-* ]]; then
+          # macOS Velopack icon: prefer torii.icns (committed by the rebrand
+          # workflow) and fall back to torii.ico if icns is missing/empty.
+          ICON_FILE="osu.Desktop/torii.ico"
+          if [ -f "osu.Desktop/torii.icns" ] && [ -s "osu.Desktop/torii.icns" ]; then
+            ICON_FILE="osu.Desktop/torii.icns"
+            echo "Using torii.icns for macOS packaging"
+          else
+            echo "Using torii.ico as fallback for macOS packaging"
+          fi
+
+          CHANNEL="osx-x64"
+          if [[ "${{ matrix.runtime }}" == "osx-arm64" ]]; then CHANNEL="osx-arm64"; fi
+
+          vpk pack \
+            -u "torii" \
+            -v "${{ needs.version.outputs.semver }}" \
+            -p "publish/${{ matrix.runtime }}" \
+            -e "${RESOLVED_EXECUTABLE}" \
+            --packAuthors "Torii Team" \
+            --packTitle "Torii Nova" \
+            -i "$ICON_FILE" \
+            -c "$CHANNEL"
+        elif [[ "${{ matrix.runtime }}" == win-* ]]; then
+          CHANNEL="win"
+          if [[ "${{ matrix.runtime }}" == "win-arm64" ]]; then CHANNEL="win-arm64"; fi
+          vpk pack \
+            -u "torii" \
+            -v "${{ needs.version.outputs.semver }}" \
+            -p "publish/${{ matrix.runtime }}" \
+            -e "${RESOLVED_EXECUTABLE}" \
+            --packAuthors "Torii Team" \
+            --packTitle "Torii Nova" \
+            -i "osu.Desktop/torii.ico" \
+            -c "$CHANNEL"
+        else
+          # Linux
+          CHANNEL="linux"
+          if [[ "${{ matrix.runtime }}" == "linux-arm64" ]]; then CHANNEL="linux-arm64"; fi
+          vpk pack \
+            -u "torii" \
+            -v "${{ needs.version.outputs.semver }}" \
+            -p "publish/${{ matrix.runtime }}" \
+            -e "${RESOLVED_EXECUTABLE}" \
+            --packAuthors "Torii Team" \
+            --packTitle "Torii Nova" \
+            -i "osu.Desktop/torii.ico" \
+            -c "$CHANNEL"
+        fi
+
+    - name: Normalize asset names (optional)
+      shell: bash
+      run: |
+        shopt -s nullglob
+        # Windows installer rename to install.exe if present
+        if [[ "${{ matrix.runtime }}" == win-* ]]; then
+          installers=(Releases/*-Setup.exe Releases/Setup.exe)
+          for f in "${installers[@]}"; do
+            if [[ -f "$f" ]]; then
+              mv -f "$f" "Releases/install-${{ matrix.runtime }}.exe"
+              break
+            fi
+          done
+
+          portables=(Releases/*-Portable.zip)
+          for f in "${portables[@]}"; do
+            if [[ -f "$f" ]]; then
