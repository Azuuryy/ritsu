+name: Build Dev
+
+on:
+  push:
+    branches: [ develop, feature/* ]
+  pull_request:
+    branches: [ develop ]
+
+env:
+  # Documented for reference; real install uses both 8.x and 10.x in
+  # the Setup .NET step (global.json pins 10.0.100 since the .NET 10
+  # + CoreCLR Android migration).
+  DOTNET_VERSION: '10.0.x'
+  FRAMEWORK_REPOSITORY: 'ShikkesoraSIM/torii-framework'
+  FRAMEWORK_REF: '25e68d530f7116437c4cfaf127169ac4d6619927'
+  RESOURCES_REPOSITORY: 'ShikkesoraSIM/torii-resources'
+  RESOURCES_REF: '2a516e45ba416dbd2cf8b821661909109f738b34'
+
+jobs:
+  build-dev:
+    name: Quick Build Check
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+
+    steps:
+    - name: Checkout code
+      uses: actions/checkout@v4
+
+    - name: Checkout framework dependency
+      uses: actions/checkout@v4
+      with:
+        repository: ${{ env.FRAMEWORK_REPOSITORY }}
+        fetch-depth: 1
+        ref: ${{ env.FRAMEWORK_REF }}
+        path: toriirefresh-framework
+
+    - name: Checkout resources dependency
+      uses: actions/checkout@v4
+      with:
+        repository: ${{ env.RESOURCES_REPOSITORY }}
+        fetch-depth: 1
+        ref: ${{ env.RESOURCES_REF }}
+        path: toriirefresh-resources
+
+    - name: Place dependencies in expected sibling paths
+      shell: bash
+      run: |
+        rm -rf ../toriirefresh-framework ../toriirefresh-resources
+        mv toriirefresh-framework ../toriirefresh-framework
+        mv toriirefresh-resources ../toriirefresh-resources
+
+    - name: Setup .NET
+      uses: actions/setup-dotnet@v4
+      with:
+        dotnet-version: |
+          8.0.x
+          10.0.x
+
+    - name: Cache NuGet packages
+      uses: actions/cache@v4
+      with:
+        path: |
+          ~/.nuget/packages
+          ~/.local/share/NuGet/v3-cache
+          ~/.cache/NuGet/v3-cache
+        key: ${{ runner.os }}-nuget-${{ hashFiles('**/*.csproj', '**/packages.lock.json', 'nuget.config') }}
+        restore-keys: |
+          ${{ runner.os }}-nuget-${{ hashFiles('**/*.csproj') }}
+          ${{ runner.os }}-nuget-
+
+    - name: Restore dependencies
+      timeout-minutes: 15
+      run: dotnet restore osu.Desktop/osu.Desktop.csproj --verbosity normal --configfile nuget.config --no-cache
+
+    - name: Build project
+      run: dotnet build osu.Desktop/osu.Desktop.csproj -c Release --no-restore
+
+    - name: Run tests (if any)
+      run: dotnet test osu.Game.Tests/ --no-restore --verbosity normal
+      continue-on-error: true
+
+    - name: Build summary
+      run: |
+        echo "Development build check completed."
+        echo "This is a fast CI verification run and does not generate installers."
+        echo "Push to main/master or create a tag to trigger full release builds."
