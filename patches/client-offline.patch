+// Adapted from Modosu (Azuuryy), derived from MOsu (p-720), GPL-3.0.
+// See LICENCE-Modosu.txt in the distribution.
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using osu.Framework.Allocation;
+using osu.Framework.Bindables;
+using osu.Framework.Graphics;
+using osu.Framework.Graphics.Containers;
+using osu.Framework.Graphics.Effects;
+using osu.Framework.Graphics.Shapes;
+using osu.Framework.Localisation;
+using osu.Game.Graphics;
+using osu.Game.Graphics.Sprites;
+using osu.Game.Offline;
+using osu.Game.Online.Leaderboards;
+using osu.Game.Overlays.Profile.Header.Components;
+using osu.Game.Scoring;
+using osu.Game.Users;
+using osuTK;
+
+namespace osu.Game.Overlays.Profile
+{
+    /// <summary>Local adaptation of Modosu's osu!-style profile header.</summary>
+    public partial class RitsuLocalProfileHeader : TabControlOverlayHeader<LocalisableString>
+    {
+        public readonly Bindable<UserProfileData?> User = new Bindable<UserProfileData?>();
+
+        private RitsuLocalTopHeader top = null!;
+        private RitsuLocalDetails details = null!;
+
+        public RitsuLocalProfileHeader()
+        {
+            ContentSidePadding = WaveOverlayContainer.HORIZONTAL_PADDING;
+            TabControl.AddItem("Profile");
+        }
+
+        protected override OverlayTitle CreateTitle() => new LocalProfileTitle();
+
+        protected override Drawable CreateContent() => new FillFlowContainer
+        {
+            RelativeSizeAxes = Axes.X,
+            AutoSizeAxes = Axes.Y,
+            Direction = FillDirection.Vertical,
+            Children = new Drawable[]
+            {
+                top = new RitsuLocalTopHeader { User = { BindTarget = User } },
+                details = new RitsuLocalDetails { User = { BindTarget = User } },
+            },
+        };
+
+        public void RefreshProfiles(IReadOnlyDictionary<Guid, double>? pp = null) => top.RefreshProfiles(pp);
+
+        public void SetHistory(IReadOnlyList<RitsuPpPoint> pp) => details.SetHistory(pp);
+
+        public void SetLocalRank(int? rank) => details.SetLocalRank(rank);
+
+        private partial class LocalProfileTitle : OverlayTitle
+        {
+            public LocalProfileTitle()
+            {
+                Title = "Local profiles";
+                Icon = OsuIcon.Player;
+            }
+        }
+    }
+
+    /// <summary>Modosu's avatar, username and row of profile pills.</summary>
+    public partial class RitsuLocalTopHeader : CompositeDrawable
+    {
+        public readonly Bindable<UserProfileData?> User = new Bindable<UserProfileData?>();
+        private readonly RitsuProfileCardRow cards;
+        private readonly RitsuProfileAvatar avatar;
+        private readonly OsuSpriteText username;
+        private readonly Box background;
+
+        public RitsuLocalTopHeader()
+        {
+            RelativeSizeAxes = Axes.X;
+            Height = 100;
+            InternalChildren = new Drawable[]
+            {
+                background = new Box { RelativeSizeAxes = Axes.Both },
+                new GridContainer
+                {
+                    RelativeSizeAxes = Axes.Both,
+                    Padding = new MarginPadding { Horizontal = WaveOverlayContainer.HORIZONTAL_PADDING, Vertical = 10 },
+                    ColumnDimensions = new[] { new Dimension(GridSizeMode.Absolute, 80), new Dimension() },
+                    RowDimensions = new[] { new Dimension() },
+                    Content = new[]
+                    {
+                        new Drawable[]
+                        {
+                            avatar = new RitsuProfileAvatar
+                            {
+                                Size = new Vector2(65),
+                                Anchor = Anchor.CentreLeft,
+                                Origin = Anchor.CentreLeft,
+                                Masking = true,
+                                CornerRadius = 20,
+                                EdgeEffect = new EdgeEffectParameters { Type = EdgeEffectType.Shadow, Radius = 3, Colour = Colour4.Black.Opacity(0.25f), Offset = new Vector2(0, 1) },
+                            },
+                            new FillFlowContainer
+                            {
+                                RelativeSizeAxes = Axes.X,
+                                AutoSizeAxes = Axes.Y,
+                                Anchor = Anchor.CentreLeft,
+                                Origin = Anchor.CentreLeft,
+                                Direction = FillDirection.Vertical,
+                                Spacing = new Vector2(0, 4),
+                                Children = new Drawable[]
+                                {
+                                    username = new TruncatingSpriteText { RelativeSizeAxes = Axes.X, Font = OsuFont.GetFont(size: 24, weight: FontWeight.Regular) },
+                                    cards = new RitsuProfileCardRow(),
+                                },
+                            },
+                        },
+                    },
+                },
+            };
+        }
+
+        [BackgroundDependencyLoader]
+        private void load(OverlayColourProvider colours) => background.Colour = colours.Background3;
+
+        protected override void LoadComplete()
+        {
+            base.LoadComplete();
+            User.BindValueChanged(e =>
+            {
+                username.Text = e.NewValue?.User.Username ?? string.Empty;
+            }, true);
+        }
+
+        public void RefreshProfiles(IReadOnlyDictionary<Guid, double>? pp = null) => cards.Refresh(pp);
+    }
+
+    /// <summary>Modosu's main-details and extended-details arrangement, using local-only fields.</summary>
+    public partial class RitsuLocalDetails : CompositeDrawable
+    {
+        public readonly Bindable<UserProfileData?> User = new Bindable<UserProfileData?>();
+        private RitsuLocalMainDetails main = null!;
+
+        [BackgroundDependencyLoader]
+        private void load(OverlayColourProvider colours)
+        {
+            RelativeSizeAxes = Axes.X;
+            AutoSizeAxes = Axes.Y;
+            InternalChildren = new Drawable[]
+            {
+                new Box { RelativeSizeAxes = Axes.Both, Colour = colours.Background5 },
+                new GridContainer
+                {
+                    RelativeSizeAxes = Axes.X,
+                    AutoSizeAxes = Axes.Y,
+                    Padding = new MarginPadding { Horizontal = WaveOverlayContainer.HORIZONTAL_PADDING, Vertical = 10 },
+                    RowDimensions = new[] { new Dimension(GridSizeMode.AutoSize) },
+                    ColumnDimensions = new[] { new Dimension(), new Dimension(GridSizeMode.AutoSize), new Dimension(GridSizeMode.AutoSize) },
+                    Content = new[]
+                    {
+                        new Drawable[]
+                        {
+                            main = new RitsuLocalMainDetails { RelativeSizeAxes = Axes.X, User = { BindTarget = User } },
+                            new Box { RelativeSizeAxes = Axes.Y, Width = 2, Colour = colours.Background6, Margin = new MarginPadding { Horizontal = 15 } },
+                            new RitsuLocalExtendedDetails { Anchor = Anchor.CentreLeft, Origin = Anchor.CentreLeft, User = { BindTarget = User } },
+                        },
+                    },
+                },
+            };
+        }
+
+        public void SetHistory(IReadOnlyList<RitsuPpPoint> pp) => Schedule(() => main.SetHistory(pp));
+
+        public void SetLocalRank(int? rank) => Schedule(() => main.SetLocalRank(rank));
+    }
+
+    public partial class RitsuLocalMainDetails : CompositeDrawable
+    {
+        public readonly Bindable<UserProfileData?> User = new Bindable<UserProfileData?>();
+        private readonly Dictionary<ScoreRank, OsuSpriteText> grades = new Dictionary<ScoreRank, OsuSpriteText>();
+        private ProfileValueDisplay performance = null!;
+        private ProfileValueDisplay estimatedRank = null!;
+        private ProfileValueDisplay localRank = null!;
+        private RitsuPpGraph ppGraph = null!;
+        private OsuSpriteText graphPlaceholder = null!;
+
+        [BackgroundDependencyLoader]
+        private void load()
+        {
+            AutoSizeAxes = Axes.Y;
+            InternalChild = new FillFlowContainer
+            {
+                RelativeSizeAxes = Axes.X,
+                AutoSizeAxes = Axes.Y,
+                Direction = FillDirection.Vertical,
+                Spacing = new Vector2(0, 7),
+                Children = new Drawable[]
+                {
+                    new GridContainer
+                    {
+                        RelativeSizeAxes = Axes.X,
+                        AutoSizeAxes = Axes.Y,
+                        RowDimensions = new[] { new Dimension(GridSizeMode.AutoSize) },
+                        ColumnDimensions = new[] { new Dimension(), new Dimension(), new Dimension() },
+                        Content = new[]
+                        {
+                            new Drawable[]
+                            {
+                                performance = new ProfileValueDisplay(true) { Title = "Performance points" },
+                                estimatedRank = new ProfileValueDisplay(true) { Title = "Estimated global rank" },
+                                localRank = new ProfileValueDisplay(true) { Title = "Local rank" },
+                            },
+                        },
+                    },
+                    new OsuSpriteText { Text = "PP history", Font = OsuFont.GetFont(size: 12) },
+                    new Container
+                    {
+                        RelativeSizeAxes = Axes.X,
+                        Height = 60,
+                        Children = new Drawable[]
+                        {
+                            ppGraph = new RitsuPpGraph { RelativeSizeAxes = Axes.Both },
+                            graphPlaceholder = new OsuSpriteText { Anchor = Anchor.Centre, Origin = Anchor.Centre, Text = "Play more scores to display the history", Font = OsuFont.GetFont(size: 12) },
+                        },
+                    },
+                    new FillFlowContainer
+                    {
+                        RelativeSizeAxes = Axes.X,
+                        AutoSizeAxes = Axes.Y,
+                        Direction = FillDirection.Horizontal,
+                        Spacing = new Vector2(5, 0),
+                        Children = new Drawable[]
+                        {
+                            grade(ScoreRank.XH), grade(ScoreRank.X), grade(ScoreRank.SH), grade(ScoreRank.S), grade(ScoreRank.A),
+                        },
+                    },
+                },
+            };
+        }
+
+        private Drawable grade(ScoreRank rank) => new FillFlowContainer
+        {
+            AutoSizeAxes = Axes.Y,
+            Width = 44,
+            Direction = FillDirection.Vertical,
+            Children = new Drawable[]
+            {
+                new DrawableRank(rank) { RelativeSizeAxes = Axes.X, Height = 22 },
+                grades[rank] = new OsuSpriteText { Anchor = Anchor.TopCentre, Origin = Anchor.TopCentre, Font = OsuFont.GetFont(size: 12, weight: FontWeight.Bold) },
+            },
+        };
+
+        protected override void LoadComplete()
+        {
+            base.LoadComplete();
+            User.BindValueChanged(e =>
+            {
+                var stats = e.NewValue?.User.Statistics;
+                performance.Content.Text = stats?.PP != null ? $"{stats.PP.Value:N0}pp" : "0pp";
+                performance.Content.TooltipText = "PP estimated from scores associated with this local profile.";
+                estimatedRank.Content.Text = stats?.GlobalRank?.ToString("\\##,##0") ?? "–";
+                estimatedRank.Content.TooltipText = e.NewValue?.Ruleset.ShortName != "osu"
+                    ? "Estimated rank data is currently available for osu!standard only."
+                    : stats?.GlobalRank == null
+                        ? "Earn local PP to estimate a rank."
+                        : "Offline estimate from a 10,000-profile osu! sample (September 2026); this is not an official leaderboard rank.";
+                foreach (var entry in grades)
+                    entry.Value.Text = (stats?.GradesCount[entry.Key] ?? 0).ToString("N0");
+            }, true);
+        }
+
+        public void SetHistory(IReadOnlyList<RitsuPpPoint> pp) => Schedule(() =>
+        {
+            // Modosu shows a zero baseline when the profile has just one PP result.
+            ppGraph.SetHistory(pp.Count == 1
+                ? new[] { new RitsuPpPoint(pp[0].Date.AddDays(-1), 0), pp[0] }
+                : pp.TakeLast(180));
+            graphPlaceholder.Alpha = pp.Count == 0 ? 1 : 0;
+        });
+
+        public void SetLocalRank(int? rank) => Schedule(() =>
+        {
+            localRank.Content.Text = rank.HasValue ? $"#{rank.Value:N0}" : "–";
+            localRank.Content.TooltipText = "Rank among this client's local profiles for this mode.";
+        });
+
+        private partial class RitsuPpGraph : UserGraph<DateTimeOffset, double>
+        {
+            public void SetHistory(IEnumerable<RitsuPpPoint> points) => Data = points.Select(p => new KeyValuePair<DateTimeOffset, double>(p.Date, p.PP)).ToArray();
+            protected override float GetDataPointHeight(double value) => (float)value;
+            protected override UserGraphTooltipContent GetTooltipContent(DateTimeOffset date, double value) => new UserGraphTooltipContent { Name = "Estimated local PP", Count = $"{value:0.##} pp", Time = date.LocalDateTime.ToString("g") };
+        }
+
+    }
+
+    public partial class RitsuLocalExtendedDetails : CompositeDrawable
+    {
+        public readonly Bindable<UserProfileData?> User = new Bindable<UserProfileData?>();
+        private readonly Dictionary<string, OsuSpriteText> values = new Dictionary<string, OsuSpriteText>();
+
+        [BackgroundDependencyLoader]
+        private void load(OverlayColourProvider colours)
+        {
+            AutoSizeAxes = Axes.Both;
+            CornerRadius = 6;
+            Masking = true;
+            string[] labels = { "Hit accuracy", "Play count", "Total score", "Total hits", "Hits per play", "Maximum combo" };
+            InternalChildren = new Drawable[]
+            {
+                new Box { RelativeSizeAxes = Axes.Both, Colour = colours.Background4 },
+                new FillFlowContainer
+                {
+                    AutoSizeAxes = Axes.Both,
+                    Direction = FillDirection.Horizontal,
+                    Spacing = new Vector2(20, 0),
+                    Padding = new MarginPadding { Vertical = 18, Horizontal = 12 },
+                    Children = new Drawable[]
+                    {
+                        new FillFlowContainer
+                        {
+                            AutoSizeAxes = Axes.Both,
+                            Direction = FillDirection.Vertical,
+                            Spacing = new Vector2(0, 4),
+                            Children = labels.Select(label => new ExtendedDetails.ExtendedDetailsEntryLabel(colours) { Text = label }).ToArray(),
+                        },
+                        new FillFlowContainer
+                        {
+                            AutoSizeAxes = Axes.Both,
+                            Direction = FillDirection.Vertical,
+                            Spacing = new Vector2(0, 4),
+                            Children = labels.Select(label => values[label] = new ExtendedDetails.ExtendedDetailsEntryValue(colours)).ToArray(),
+                        },
+                    },
+                },
+            };
+        }
+
+        protected override void LoadComplete()
+        {
+            base.LoadComplete();
+            User.BindValueChanged(e => update(e.NewValue?.User.Statistics), true);
+        }
+
+        private void update(UserStatistics? stats)
+        {
+            values["Hit accuracy"].Text = $"{stats?.Accuracy ?? 0:0.00}%";
+            values["Play count"].Text = $"{stats?.PlayCount ?? 0:N0}";
+            values["Total score"].Text = $"{stats?.TotalScore ?? 0:N0}";
+            values["Total hits"].Text = $"{stats?.TotalHits ?? 0:N0}";
+            values["Hits per play"].Text = $"{(stats?.PlayCount > 0 ? stats.TotalHits / stats.PlayCount : 0):N0}";
+            values["Maximum combo"].Text = $"{stats?.MaxCombo ?? 0:N0}";
+        }
+    }
+}
diff --git a/osu.Game/Overlays/Profile/RitsuLocalScoresSection.cs b/osu.Game/Overlays/Profile/RitsuLocalScoresSection.cs
new file mode 100644
index 0000000000..fdea37b2b4
--- /dev/null
+++ b/osu.Game/Overlays/Profile/RitsuLocalScoresSection.cs
@@ -0,0 +1,213 @@
+// Adapted from Modosu (Azuuryy), derived from MOsu (p-720), GPL-3.0.
+// See LICENCE-Modosu.txt in the distribution.
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using osu.Framework.Allocation;
+using osu.Framework.Bindables;
+using osu.Framework.Graphics;
+using osu.Framework.Graphics.Containers;
+using osu.Framework.Graphics.Shapes;
+using osu.Framework.Localisation;
+using osu.Game.Graphics;
+using osu.Game.Graphics.Containers;
+using osu.Game.Graphics.Sprites;
+using osu.Game.Graphics.UserInterface;
+using osu.Game.Online.Leaderboards;
+using osu.Game.Overlays.Profile.Sections;
+using osu.Game.Resources.Localisation.Web;
+using osu.Game.Rulesets.UI;
+using osu.Game.Scoring;
+using osuTK;
+
+namespace osu.Game.Overlays.Profile
+{
+    /// <summary>The recent and best score section used by Modosu's local profiles.</summary>
+    public partial class RitsuLocalScoresSection : ProfileSection
+    {
+        public override LocalisableString Title => UsersStrings.ShowExtraTopRanksTitle;
+        public override string Identifier => "top_ranks";
+
+        private readonly RitsuScoreSubsection recent;
+        private readonly RitsuScoreSubsection best;
+        private readonly OsuSpriteText status;
+
+        public RitsuLocalScoresSection()
+        {
+            Children = new Drawable[]
+            {
+                status = new OsuSpriteText { RelativeSizeAxes = Axes.X, Font = OsuFont.GetFont(size: 14), Alpha = 0 },
+                recent = new RitsuScoreSubsection(User, UsersStrings.ShowExtraRecentActivityTitle),
+                best = new RitsuScoreSubsection(User, UsersStrings.ShowExtraTopRanksBestTitle),
+            };
+        }
+
+        public void SetError(string? message)
+        {
+            status.Text = message ?? string.Empty;
+            status.Alpha = message == null ? 0 : 1;
+        }
+
+        public void SetScores(IReadOnlyList<ScoreInfo> recentScores, IReadOnlyList<ScoreInfo> bestScores)
+        {
+            recent.SetScores(recentScores);
+            best.SetScores(bestScores);
+        }
+    }
+
+    /// <summary>Initially shows five scores and reveals more on demand, like Modosu.</summary>
+    public partial class RitsuScoreSubsection : ProfileSubsection
+    {
+        private IReadOnlyList<ScoreInfo> scores = Array.Empty<ScoreInfo>();
+        private int shown = 5;
+        private bool ready;
+        private FillFlowContainer items = null!;
+        private ShowMoreButton more = null!;
+        private OsuSpriteText missing = null!;
+
+        public RitsuScoreSubsection(Bindable<UserProfileData?> user, LocalisableString header)
+            : base(user, header, CounterVisibilityState.AlwaysVisible)
+        {
+        }
+
+        protected override Drawable CreateContent() => new FillFlowContainer
+        {
+            RelativeSizeAxes = Axes.X,
+            AutoSizeAxes = Axes.Y,
+            Direction = FillDirection.Vertical,
+            Children = new Drawable[]
+            {
+                items = new FillFlowContainer { RelativeSizeAxes = Axes.X, AutoSizeAxes = Axes.Y, Direction = FillDirection.Vertical, Spacing = new Vector2(0, 2) },
+                more = new ShowMoreButton { Anchor = Anchor.TopCentre, Origin = Anchor.TopCentre, Margin = new MarginPadding { Top = 10 }, Action = () => { shown += 50; refresh(); } },
+                missing = new OsuSpriteText { Text = "No local scores yet.", Font = OsuFont.GetFont(size: 14), Margin = new MarginPadding { Vertical = 4 } },
+            },
+        };
+
+        protected override void LoadComplete()
+        {
+            base.LoadComplete();
+            ready = true;
+            refresh();
+        }
+
+        public void SetScores(IReadOnlyList<ScoreInfo> value)
+        {
+            scores = value;
+            shown = 5;
+            if (ready) refresh();
+        }
+
+        private void refresh()
+        {
+            items.Clear();
+            foreach (var score in scores.Take(shown))
+                items.Add(new RitsuProfileScore(score));
+            SetCount(scores.Count);
+            missing.Alpha = scores.Count == 0 ? 1 : 0;
+            more.Alpha = shown < scores.Count ? 1 : 0;
+        }
+    }
+
+    /// <summary>A local score row using Modosu's rank, beatmap, accuracy and PP layout.</summary>
+    public partial class RitsuProfileScore : OsuClickableContainer
+    {
+        private const float pp_width = 100;
+        private readonly ScoreInfo score;
+
+        [Resolved(canBeNull: true)]
+        private OsuGame? game { get; set; }
+
+        [Resolved(canBeNull: true)]
+        private RitsuLocalProfileOverlay? overlay { get; set; }
+
+        public RitsuProfileScore(ScoreInfo score)
+        {
+            this.score = score;
+            RelativeSizeAxes = Axes.X;
+            Height = 48;
+        }
+
+        [BackgroundDependencyLoader]
+        private void load(OverlayColourProvider colours, OsuColour osuColours)
+        {
+            string title = score.BeatmapInfo?.Metadata?.Title ?? score.BeatmapHash;
+            string artist = score.BeatmapInfo?.Metadata?.Artist ?? string.Empty;
+            string difficulty = score.BeatmapInfo?.DifficultyName ?? "Unknown";
+            Action = () => { overlay?.Hide(); game?.PresentScore(score); };
+
+            Child = new ProfileItemContainer
+            {
+                Children = new Drawable[]
+                {
+                    new Container
+                    {
+                        RelativeSizeAxes = Axes.Both,
+                        Padding = new MarginPadding { Left = 20, Right = pp_width + 10 },
+                        Children = new Drawable[]
+                        {
+                            new UpdateableRank(score.Rank) { Anchor = Anchor.CentreLeft, Origin = Anchor.CentreLeft, Size = new Vector2(50, 20) },
+                            new FillFlowContainer
+                            {
+                                Anchor = Anchor.CentreLeft,
+                                Origin = Anchor.CentreLeft,
+                                RelativeSizeAxes = Axes.X,
+                                AutoSizeAxes = Axes.Y,
+                                Padding = new MarginPadding { Left = 60, Right = 200 },
+                                Direction = FillDirection.Vertical,
+                                Children = new Drawable[]
+                                {
+                                    new TruncatingSpriteText { RelativeSizeAxes = Axes.X, Text = $"{title} by {artist}", Font = OsuFont.GetFont(size: 14, weight: FontWeight.SemiBold, italics: true) },
+                                    new TruncatingSpriteText { RelativeSizeAxes = Axes.X, Text = $"{difficulty}  ·  {score.Date.LocalDateTime:g}", Font = OsuFont.GetFont(size: 12), Colour = osuColours.Yellow },
+                                },
+                            },
+                            new FillFlowContainer
+                            {
+                                Anchor = Anchor.CentreRight,
+                                Origin = Anchor.CentreRight,
+                                AutoSizeAxes = Axes.Both,
+                                Direction = FillDirection.Horizontal,
+                                Spacing = new Vector2(8, 0),
+                                Children = new Drawable[]
+                                {
+                                    new OsuSpriteText { Anchor = Anchor.CentreLeft, Origin = Anchor.CentreLeft, Text = $"{score.Accuracy * 100:0.00}%", Font = OsuFont.GetFont(size: 14, weight: FontWeight.Bold), Colour = osuColours.Yellow },
+                                    new FillFlowContainer
+                                    {
+                                        AutoSizeAxes = Axes.Both,
+                                        Anchor = Anchor.CentreLeft,
+                                        Origin = Anchor.CentreLeft,
+                                        Direction = FillDirection.Horizontal,
+                                        Spacing = new Vector2(2, 0),
+                                        Children = score.Mods.Select(mod => new ModIcon(mod) { Scale = new Vector2(0.35f) }).ToArray(),
+                                    },
+                                },
+                            },
+                        },
+                    },
+                    new Container
+                    {
+                        RelativeSizeAxes = Axes.Y,
+                        Width = pp_width,
+                        Anchor = Anchor.CentreRight,
+                        Origin = Anchor.CentreRight,
+                        Children = new Drawable[]
+                        {
+                            new Box { RelativeSizeAxes = Axes.Both, Colour = colours.Background3 },
+                            new FillFlowContainer
+                            {
+                                Anchor = Anchor.Centre,
+                                Origin = Anchor.Centre,
+                                AutoSizeAxes = Axes.Both,
+                                Direction = FillDirection.Vertical,
+                                Children = new Drawable[]
+                                {
+                                    new OsuSpriteText { Text = score.PP.HasValue ? $"{score.PP.Value:N0}pp" : "– pp", Font = OsuFont.GetFont(size: 14, weight: FontWeight.Bold), Colour = colours.Highlight1 },
+                                    new OsuSpriteText { Text = $"{score.TotalScore:N0}", Font = OsuFont.GetFont(size: 11), Colour = colours.Light3 },
+                                },
+                            },
+                        },
+                    },
+                },
+            };
+        }
+    }
+}
