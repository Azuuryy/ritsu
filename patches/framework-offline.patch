diff --git a/osu.Framework/Statistics/FrameProfileCapture.cs b/osu.Framework/Statistics/FrameProfileCapture.cs
new file mode 100644
index 000000000..a76ac9c85
--- /dev/null
+++ b/osu.Framework/Statistics/FrameProfileCapture.cs
@@ -0,0 +1,128 @@
+// Copyright (c) 2026 Ritsu contributors. Licensed under the MIT Licence.
+
+#nullable enable
+
+using System;
+using System.Diagnostics;
+using System.Threading;
+
+namespace osu.Framework.Statistics
+{
+    /// <summary>
+    /// An opt-in observer of completed game-thread frames and explicitly instrumented operations.
+    /// </summary>
+    public sealed class FrameProfileCapture : IDisposable
+    {
+        private static FrameProfileCapture? active;
+        private readonly FrameProfileFrame[] frames;
+        private readonly FrameProfileOperation[] operations;
+        private int frameCount;
+        private int operationCount;
+        private int writers;
+
+        internal static FrameProfileCapture? Active => Volatile.Read(ref active);
+
+        internal bool IncludeDetails { get; }
+
+        public bool IsActive => Active == this;
+
+        public long StartTimestamp { get; } = Stopwatch.GetTimestamp();
+
+        public FrameProfileCapture(int frameCapacity, int operationCapacity, bool includeDetails = true)
+        {
+            IncludeDetails = includeDetails;
+            frames = new FrameProfileFrame[frameCapacity];
+            operations = new FrameProfileOperation[operationCapacity];
+            if (Interlocked.CompareExchange(ref active, this, null) != null)
+                throw new InvalidOperationException("A frame capture is already running.");
+        }
+
+        public static Operation Measure(string name) => new Operation(Active is { IncludeDetails: true } capture ? capture : null, name);
+
+        public static void Count(string name, long value)
+        {
+            var capture = Active;
+            if (capture is { IncludeDetails: true })
+                capture.record(new FrameProfileOperation(name, Stopwatch.GetTimestamp(), 0, Environment.CurrentManagedThreadId, value));
+        }
+
+        internal void Record(FrameProfileFrame frame)
+        {
+            Interlocked.Increment(ref writers);
+            try
+            {
+                if (Active != this)
+                    return;
+
+                int index = Interlocked.Increment(ref frameCount) - 1;
+                if (index < frames.Length)
+                    frames[index] = frame;
+            }
+            finally
+            {
+                Interlocked.Decrement(ref writers);
+            }
+        }
+
+        private void record(FrameProfileOperation operation)
+        {
+            Interlocked.Increment(ref writers);
+            try
+            {
+                if (Active != this)
+                    return;
+
+                int index = Interlocked.Increment(ref operationCount) - 1;
+                if (index < operations.Length)
+                    operations[index] = operation;
+            }
+            finally
+            {
+                Interlocked.Decrement(ref writers);
+            }
+        }
+
+        public void Dispose() => Interlocked.CompareExchange(ref active, null, this);
+
+        // Stop and read from a worker thread, after any writes that already started have finished.
+        public FrameProfileSnapshot Snapshot()
+        {
+            Dispose();
+            SpinWait.SpinUntil(() => Volatile.Read(ref writers) == 0);
+            return new FrameProfileSnapshot(StartTimestamp, Stopwatch.Frequency,
+                frames.AsSpan(0, Math.Min(frameCount, frames.Length)).ToArray(),
+                operations.AsSpan(0, Math.Min(operationCount, operations.Length)).ToArray(),
+                Math.Max(0, frameCount - frames.Length), Math.Max(0, operationCount - operations.Length));
+        }
+
+        public readonly struct Operation : IDisposable
+        {
+            private readonly FrameProfileCapture? capture;
+            private readonly string name;
+            private readonly long start;
+
+            internal Operation(FrameProfileCapture? capture, string name)
+            {
+                this.capture = capture;
+                this.name = name;
+                start = capture == null ? 0 : Stopwatch.GetTimestamp();
+            }
+
+            public void Dispose()
+            {
+                if (capture != null)
+                    capture.record(new FrameProfileOperation(name, start, Stopwatch.GetTimestamp() - start, Environment.CurrentManagedThreadId, null));
+            }
+        }
+    }
+
+    public readonly record struct FrameProfileFrame(
+        string Thread, int ManagedThreadId, ulong FrameIndex, ulong ProducedFrame, long Start, long End, double BudgetMs,
+        double WorkMs, double SchedulerMs, double SleepMs, double SwapMs, double GcMs, double DrawResetMs,
+        double WindowMessagesMs, double IpcMs, double DebugMs, long AllocatedBytes, long Invalidations, long Refreshes);
+
+    public readonly record struct FrameProfileOperation(string Name, long Start, long Duration, int ManagedThreadId, long? Value);
+
+    public sealed record FrameProfileSnapshot(long StartTimestamp, long Frequency, FrameProfileFrame[] Frames,
+        FrameProfileOperation[] Operations, int DroppedFrames, int DroppedOperations);
+}
