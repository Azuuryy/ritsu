# Announce published GitHub releases in a Discord channel.
#
# Inactive on purpose: the current offline milestone disables external
# communications, and GitHub Actions ignores workflow files that do not end
# in .yml or .yaml. Nothing is posted while this file keeps its .disabled
# suffix.
#
# To enable it, follow README.md ("Release announcements on Discord"):
# create a Discord webhook, store its URL in the DISCORD_WEBHOOK_URL secret,
# then rename this file to github-releases-to-discord.yml.
#
# Pinned to github-releases-to-discord v1.20.0 (tag v1); update this SHA
# deliberately after reviewing the release notes.
# https://github.com/SethCohen/github-releases-to-discord

name: Announce releases on Discord

on:
  release:
    types: [published]
  workflow_dispatch:
    inputs:
      release_name:
        description: Release title to post
        required: true
        type: string
      release_body:
        description: Release notes to post
        required: false
        type: string
      release_html_url:
        description: Release page URL
        required: false
        type: string

permissions:
  contents: read

jobs:
  announce:
    runs-on: ubuntu-latest
    steps:
      - name: Post the release announcement
        uses: SethCohen/github-releases-to-discord@24d166886aee4646d448c8a389ff9e1ebcab3682
        with:
          webhook_url: ${{ secrets.DISCORD_WEBHOOK_URL }}
          username: Ritsu
          color: "2105893"
          footer_title: "Ritsu — release notes"
          footer_timestamp: true
          reduce_headings: true
          # Read only on manual runs; a release event always takes precedence.
          release_name: ${{ inputs.release_name }}
          release_body: ${{ inputs.release_body }}
          release_html_url: ${{ inputs.release_html_url }}
